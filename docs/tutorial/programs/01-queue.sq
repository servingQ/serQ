// Chapter 1: one queue.
// Requests are served one at a time, first come first served. Fed Poisson
// arrivals (workloads/01-queue.sq), this is the M/M/1 queue of every
// textbook.

let S = 1.0;          // mean service time (s)

fn main() {
  stage svc : fifo;

  server (work_size) {
    Cost s = cost(svc, S * work_size);
    set t0 = now;
    run svc (s);
    observe wait = now - t0 - S * work_size;
  }
}
