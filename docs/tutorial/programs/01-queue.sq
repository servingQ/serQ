// Chapter 1: one queue.
// Requests arrive as a Poisson process and are served one at a time,
// first come first served. This is the M/M/1 queue of every textbook.
use "std/args";

let S = 1.0;          // mean service time (s)

fn main() {
  let Lambda = args.number("Lambda", 0.8);     // arrivals per second

  stage svc : fifo;

  workload {
    arrive poisson(Lambda);
    turn { set work_size = ~exp(1); }

    session { turn; request; end; }
  }

  server {
    set s = cost(svc, S * work_size);
    set t0 = now;
    run svc (s);
    observe response = now - t0;
    observe wait = now - t0 - S * work_size;
  }


}
