// Chapter 4: the prefix cache.
// Chapter 3's workload, its token counts rounded to whole numbers
// (workloads/04-cache.sq): a token count is whole from where a KV pool reads
// it, which chapter 3 has none of, and the rounding raises each draw's mean
// by half a token. Now a turn's context lives in a KV pool. When
// the turn ends the memory is released and the context stays cached; the
// next turn of that session is a *hit* if its prefix survived. A miss
// recomputes the whole context, which costs the engine more, which makes the
// queue longer, which loses more prefixes: a feedback loop.
use "std/args";

let a = 2e-5;
let d = 2e-4;

fn main() {
  let C = args.number("C", 2e5);          // KV pool, tokens

  pool kv { cap C; evict lru; }
  stage engine : fifo;

  server (K, n, o, final) {
    hold kv (cost(kv, K + n + o)) {
      // `cached` is how much of this session's own prefix survived,
      // decided at the moment the hold is admitted
      set warm = cached >= K;
      run engine (cost(engine, (warm ? a * n : a * (K + n)) + d * o));
    } cache kv (cost(kv, K + n + o));
    if (K > 0) { observe hit = warm; }
    // a session's last turn leaves nothing worth keeping
    if (final) { drop kv; }
  }
}
