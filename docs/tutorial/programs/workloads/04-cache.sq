// Chapter 4's workload: chapter 3's sessions, their token counts whole, each
// turn sending its context so far and its new tokens apart, and whether it
// is the session's last, so the server drops the session's cached KV after
// it (04-cache.sq runs it).

let Lambda = 0.5;
let p = 0.8;
let Z = 3.0;

workload {
  arrive poisson(Lambda);
  init { set K = 0; }
  turn {
    // token counts are whole numbers: the workload rounds what it draws
    set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
    set o = floor(~exp(200)) + 1;
    set more = ~bernoulli(p);
  }
  send (K, n, o, final: more == 0);

  session {
    loop {
      turn;
      set K = K + n + o;
      if (more) { tool (~exp(Z)); } else { end; }
    }
  }
}
