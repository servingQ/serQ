// Chapter 5: the engine.
// The `fifo` stage of chapters 3 and 4 served one turn at a time. A real
// LLM engine runs *iterations*: every iteration hands a token budget to the
// requests it is already running — one token to each decoding request, a
// chunk to each prefilling one — and then admits waiting requests with
// whatever budget is left. Prefill and decode share the same iteration.
use "std/args";

let B = 2048;          // token budget per iteration (max_num_batched_tokens)
let bs = 16;           // tokens per block
let alpha = 2e-5;      // compute per scheduled token (s)
let omega = 2e-4;      // weights read per iteration (s)
let beta = 2e-9;       // KV read per iteration per resident token (s)
let p = 0.8;

fn main() {
  let max_seqs = args.number("max_seqs", 16);     // how many requests may run at once
  let blocks = args.number("blocks", 4000);     // KV blocks
  let Lambda = args.number("Lambda", 0.5);
  let Z = args.number("Z", 3.0);

  device gpu {
    compute (t) = t * alpha;
    hbm (k) = omega + beta * k;
    kv cap blocks * bs;
  }
  pool kv on gpu { block bs; evict lru; preempt lifo; }
  engine llm on gpu {
    reqs cap max_seqs;
    tokens cap B;
    // what the engine does with one request: reuse what the cache holds of
    // the prompt, prefill the rest, decode, and leave it all cached
    request (prompt, output) {
      // how much of the prompt the cache could supply, in whole blocks
      set hitmax = floor(prompt - 1, bs);
      // read when the request is admitted: while it waits, its prefix is
      // still evictable
      at admission { reused = min(cachedin(kv), hitmax); }
      // a request preempted runs again from here; count its hit once
      set c = min(cached, floor(prompt - 1, bs));
      if (computed == 0) { observe hit = c > 0; }
      prefill (prompt - c) growing kv;
      decode (output - 1) growing kv;
      cache (prompt + output);
    }
    scheduler {
      advance running;
      // a running slot, and the blocks of the reused prefix plus the chunk
      // the budget left allows; only if the whole prompt fits, as vLLM's
      // default scheduler_reserve_full_isl (config/scheduler.py:191)
      admit waiting while (running.preempted == 0)
        taking reqs (1), kv (min(prompt, reused + budget_left(llm))) reserve (prompt);
    }
    // an iteration costs whichever is larger: reading the weights and the
    // running requests' KV, or computing the tokens it scheduled
    worker {
      forward (max(hbm(batch.kv_decode + batch.kv_prefill), compute(batch.tokens)));
    }
  }
  pool reqs on llm { queue fifo; }

  workload {
    arrive poisson(Lambda);
    init { set K = 0; }
    turn {
      set n = K == 0 ? ~uniform(1000, 3000) : ~exp(500);
      set o = ~exp(200) + 1;
    }
    // the conversation: a request per turn, then a tool call and the next
    // turn, or the end
    session {
      loop {
        turn;
        set K = prompt + o;
        if (~bernoulli(p)) { tool (~exp(Z)); } else { drop kv; end; }
      }
    }
  }

  // a turn is one request to the engine
  server {
    set prompt = K + n;
    llm (prompt, o);
  }
}
