// Chapter 3: a session is many turns.
// A session prefills its context, decodes an answer, calls a tool, and
// comes back with a longer context (workloads/03-sessions.sq). Here every
// turn is one pass through a single engine.

let a = 2e-5;         // prefill: seconds per token
let d = 2e-4;         // decode: seconds per token

fn main() {
  stage engine : fifo;

  server (input, output) {
    run engine (cost(engine, a * input + d * output));
  }
}
