// An iteration cost that reads every context variable the Lean fragment has:
// batch.tokens, batch.prefilled, batch.decoding, batch.kv_decode and
// batch.attention (an even coefficient:
// the fragment holds twice the attention work). The second prompt is longer
// than the budget, so its chunks have positions; both decode while holding
// what they prefilled. The Lean semantics must give the interpreter's
// answer (lean/Serq/Regress.lean).
fn main() {
  device gpu { kv cap 2048; }
  engine llm on gpu {
    slots cap 4;
    tokens cap 48;
    request (prompt, output, t0) {
      prefill (prompt) growing kv;
      observe ttft = now - t0;
      decode (output) growing kv;
      observe done = now;
    }
    scheduler {
      advance running;
      admit waiting while (running.preempted == 0)
        taking slots (1), kv (min(prompt, budget_left(llm))) reserve (prompt);
    }
    worker {
      forward (3 + batch.tokens + 2 * batch.prefilled + batch.decoding + batch.kv_decode + 2 * batch.attention);
    }
  }
  pool kv on gpu { block 16; evict lru; preempt lifo; }
  pool slots on llm { }
  stage gate : delay;

  workload {
    arrive batch(2);
    init { set n = 0; set o = 0; set t0 = 0; }
  }

  server {
    run gate (cost(gate, t0));
    llm (n, o, t0);
  }
}
