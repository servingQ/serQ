// An iteration cost that reads every context variable the Lean fragment has:
// tokens, prefilled, decoders, kv_decode and attention (an even coefficient:
// the fragment holds twice the attention work). The second prompt is longer
// than the budget, so its chunks have positions; both decode while holding
// what they prefilled. The Lean semantics must give the interpreter's
// answer (lean/Serq/Regress.lean).
fn main() {
  device gpu { kv cap 2048; }
  engine llm on gpu {
    slots cap 4;
    tokens cap 48;
    schedule { advance running; admit waiting while (running.preempted == 0); }
    execute (3 + batch.tokens + 2 * batch.prefilled + batch.decoding + batch.kv_decode + 2 * batch.attention);
  }
  pool kv on gpu { block 16; evict lru; preempt lifo; }
  pool slots on llm { }
  stage gate : delay;

  workload {
    arrive batch(2);
    init { set n = 0; set o = 0; set t0 = 0; }

  }

  server {
    run gate (cost(gate, t0));
    hold slots (cost(slots, 1)), kv (cost(kv, min(n, budget_left(llm)))) reserve (cost(kv, n)) {
      run llm prefill (cost(llm, n)) growing kv;
      observe ttft = now - t0;
      run llm decode (cost(llm, o)) growing kv;
      observe done = now;
    }
  }


}
