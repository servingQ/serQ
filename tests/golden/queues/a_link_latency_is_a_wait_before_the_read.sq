
        let x0 = 0.5; let x1 = 0.25;
        stage egress : ps(100);
        stage ingress[2] : ps(200);
        pool kvP[2] { cap 1000; }
        stage P[2] : fifo;
        device gpu[2] { kvD cap 1000; } pool kvD on gpu { block 16; }
        engine D[2] on gpu { tokens cap inf; scheduler { advance running; admit waiting while (running.preempted == 0); } worker { forward (1); } }
        use "std/share";
        server {
          hold kvP[i] (cost(kvP, prompt)) { run P[i] (cost(P, prompt)); } cache (cost(kvP, prompt)) lease kvP[i] (inf);
          hold kvD[j] (cost(kvD, prompt)) {
            // the wait x1 + x0 is the transfer run's `latency` in the IR (14), which no flat program spells
            transfer on egress, ingress[j] (prompt, share = share.maxmin) from kvP[i] to kvD[j] (prompt - 1);
            run D[j] decode (cost(D, o - 1)) growing kvD[j];
          }
        }
        workload { arrive batch(1); hidden o; init { set prompt = 32; set o = 4; set i = 1; set j = 0; } session { turn; end; } }
        