// One vLLM v1 request on the step clock: the program of the vLLM scheduler
// oracle (tools/oracle/*.json, tests/vllm_oracle.rs) and, compiled to IR,
// of the Lean theorems about it (serving-queue-theory SeqOracle.lean).
// The constants are a scenario's engine; the requests are the workload
// instance, given as explicit sessions in the IR (prompt, o, arrive).
let bs = 16;           // block_size
let B = 1024;          // max_num_batched_tokens
let blocks = 999;      // num_gpu_blocks less the null block
let max_seqs = 16;     // max_num_seqs
let chunk = 0;         // long_prefill_token_threshold (0: none)

pool slots { cap max_seqs; admit via engine; }
pool kv { cap blocks * bs; block bs; evict lru; preempt lifo; }
stage engine : step { budget B; chunk chunk; cost 1; memory kv; }
stage gate : delay;

workload { arrive batch(1); init { set prompt = 1; set o = 1; set arrive = 0; } }

session {
  run gate (arrive);
  // the scheduler admits with the blocks of the chunk the budget the
  // running requests leave allows, if the whole prompt fits
  // (scheduler_reserve_full_isl), and grows from there
  hold slots (1), kv (min(prompt, budget_left(engine))) fits (prompt) {
    run engine prefill (prompt) growing kv;
    observe first = now;
    run engine decode (o - 1) growing kv;
  }
  observe done = now;
  end;
}

run { horizon 100000; }
