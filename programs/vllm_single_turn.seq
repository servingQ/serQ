// vLLM v1 serving single-turn requests: a session is one request — a
// prompt, an answer, gone. The engine (the constants down to `c0`, the
// pools, the stage and the `server` block) is `programs/vllm.seq`'s line
// for line; only the workload differs (docs/case-study-workloads.md).
let B = 8192;          // max_num_batched_tokens
let max_seqs = 16;     // max_num_seqs
let blocks = 10000;    // num_gpu_blocks (less the null block)
let bs = 16;           // block_size
let chunk_cap = 0;     // long_prefill_token_threshold (0: none)
let a = 2e-5;          // compute per scheduled token (s)
let omega = 2e-4;      // weights read per iteration (s)
let beta = 2e-9;       // KV read per iteration per resident context token (s)
let c0 = 0;            // fixed cost per iteration (s)
let Lambda = 3.0;      // requests per second

pool kv { cap blocks * bs; block bs; evict lru; preempt lifo; }
pool reqs { cap max_seqs; }

stage engine : step {
  budget B;
  chunk chunk_cap;
  cost c0 + max(omega + beta * (kvb + kvp), ntok * a);
  memory kv;
}

// --8<-- [start:workload]
// A request arrives, is served, and its session ends: no context carries
// over, so `K` stays 0 and the prefix cache is never read back (entries
// are per session, docs/language.md §9).
workload {
  arrive poisson(Lambda);
  init { set K = 0; }
  turn {
    set n = ~uniform(1000, 3000);
    set o = ~exp(200) + 1;
  }
  session { turn; request; end; }
}
// --8<-- [end:workload]

server {
  set t0 = now;
  set prompt = K + n;
  // the prefix hit (full blocks, never the whole prompt) is looked up when
  // the scheduler admits (scheduler.py:932-939), and the admission takes the
  // hit plus the chunk the budget allows (scheduler.py:1078-1128, 1214-1226);
  // docs/language.md §7 "Admission" has the argument.
  // `known` is every token the request has: the prompt, or after a
  // preemption the position it had reached plus the token sampled there
  // (vLLM keeps the generated tokens and drops only their KV,
  // scheduler.py:1560-1561); the hit can cover all but the last of them
  admit if reqs (1), kv (min(known, hit + budget_left(engine))) fit
        where known = computed < prompt ? prompt : computed + 1,
              hit = min(cachedin(kv), floor((known - 1) / bs) * bs) {
    set known = computed < prompt ? prompt : computed + 1;
    set c = min(cached, floor((known - 1) / bs) * bs);
    observe hit = c > 0;
    observe prefill_tokens = known - c;
    prefill (known - c) growing kv;
    branch (known == prompt) { observe ttft = now - t0; }   // not a resumed request's re-prefill
    decode (o - 1 - (known - prompt)) growing kv;
  } keep (prompt + o);
  observe response = now - t0;
}

run { horizon 2000; warmup 200; seed 1; }
