// programs/llmd_pd.seq on the A6000 testbed: one prefiller and one decoder
// (Qwen3-8B, block 16, budget 8192, 192 000-token pools), vLLM's toy NIXL
// proxy in front (every prompt goes to the prefiller: max_tokens = 1, then
// the decode request with the prefiller's block ids), replaying the
// short-context trace with session i sent at i * spacing seconds and turn
// k+1 `think` seconds after turn k completes. The cost model is fitted on
// lone requests through the same proxy (docs/case-study-pd.md, "On the
// A6000 testbed"): a prefill step costs cP + aP * npre + bP * attn, a decode
// step cD + dD * ndec, a transfer x0 + tokens / Bw, and the proxy's two hops
// plus the API server h per request.
let spacing = 3.0;     // seconds between session arrivals
let N = 96;            // sessions replayed
let B = 8192;          // max_num_batched_tokens
let max_seqsP = 16;
let max_seqsD = 64;
let bs = 16;
let blocksP = 12034;   // GPU KV cache size: 192 544 tokens
let blocksD = 11986;   // 191 776 tokens
let cP = 0;            // s per prefill step beyond the tokens (not separable from h on lone requests)
let aP = 1.192e-4;     // s per prefill token (fitted: 119 us)
let bP = 7.06e-9;      // s per prefill token per context token (fitted)
let cD = 0.024;        // s per decode step (fitted: 24 ms, one to four decoding requests)
let dD = 0;            // s per decoding request per step (not separable at these batch sizes)
let Bw = 99771;        // NIXL read, tokens/s (fitted on 13 lone transfers, 512-32 000 tokens; rms 17 ms)
let x0 = 0.010;        // s per transfer (fitted)
let h = 0.063;         // s per request outside the engines: proxy hops, API server (fitted, less one decode step)

pool reqsP[1] { cap max_seqsP; admit via P; }
pool kvP[1] { cap blocksP * bs; block bs; evict lru; preempt lifo; }
pool reqsD[1] { cap max_seqsD; admit via D; }
pool kvD[1] { cap blocksD * bs; block bs; evict lru; preempt lifo; admit via D; }

stage P[1] : step { budget B; cost cP + aP * npre + bP * attn; memory kvP; }
stage D[1] : step { budget B; cost cD + dD * ndec + aP * npre + bP * attn; memory kvD; }
stage link[1] : ps(1);
stage front : delay;
stage gate : delay;
stage tool : delay;

workload {
  arrive batch(N);
  trace "data/short_base.csv" ordered;
  hidden out;
  session {
    run gate (serial * spacing);
    turn;
    loop {
      request;
      branch (more) { tool think; turn; } else { end; }
    }
  }
}

server {
  set t0 = now;
  set prompt = new;
  set i = 0;
  set j = 0;
  set hitmax = forced ? 0 : floor((prompt - 1) / bs) * bs;
  set transferred = 0;
  run front (h);
  admit if reqsP[i] (1), kvP[i] (min(prompt, hit + budget_left(P[i]))) reserve (prompt) fit
        where hit = min(cachedin(kvP[i]), hitmax) {
    set c = cached;
    observe p_cached = c;
    prefill on P[i] (prompt - c) growing kvP[i];
  } keep (prompt) lease kvP[i] (inf);
  set t1 = now;
  admit if kvD[j] (known) reserve (known), reqsD[j] (0) reserve (1) fit
        reuse (floor((known - 1) / bs) * bs)
        where known = computed < prompt ? prompt : computed + 1 {
    set known = computed < prompt ? prompt : computed + 1;
    set c = cached;
    branch (!transferred) {
      observe d_cached = c;
      transfer[j] (x0 + (prompt - c) / Bw) from kvP[i] to kvD[j] (prompt - 1 - c);
      observe lease = now - t1;
      set transferred = 1;
      set c = prompt - 1;
    }
    admit if reqsD[j] (1) fit {
      prefill on D[j] (known - c) growing kvD[j];
      branch (known == prompt) { observe ttft = now - t0; }
      decode on D[j] (out - 1 - (known - prompt)) growing kvD[j];
    }
  } keep (prompt + out);
  observe sent = t0;
  observe latency = now - t0;
}

run { horizon 2000; warmup 0; seed 1; }
