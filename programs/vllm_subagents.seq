// vLLM v1 serving agents that delegate to subagents, approximated: seQ has
// no statement that creates a session (docs/design/subagents.md), so the
// subagents arrive as sessions of their own in the same Poisson stream,
// and a parent waits for them at a delay stage for `W`, the time the
// slowest of its subagents took in a previous run. The engine is
// `programs/vllm.seq`'s line for line (docs/case-study-workloads.md).
// `--set q=0` is the same agents without subagents.
let B = 8192;          // max_num_batched_tokens
let max_seqs = 16;     // max_num_seqs
let blocks = 10000;    // num_gpu_blocks (less the null block)
let bs = 16;           // block_size
let chunk_cap = 0;     // long_prefill_token_threshold (0: none)
let a = 2e-5;          // compute per scheduled token (s)
let omega = 2e-4;      // weights read per iteration (s)
let beta = 2e-9;       // KV read per iteration per resident context token (s)
let c0 = 0;            // fixed cost per iteration (s)
let Lambda = 0.1;      // agent sessions per second
let p = 0.9;           // the agent continues after a turn
let Z = 3.0;           // tool time (s)
let q = 0.3;           // a turn delegates instead of calling a tool
let k = 3;             // subagents per delegation
let pc = 0.7;          // a subagent continues after a turn
let W = 15.0;          // the wait for the subagents (s): the mean of the longest of k
                       // `subagent` samples of a previous run (`--dump`)
let kids = q * k / (1 - p);   // subagents per agent session

pool kv { cap blocks * bs; block bs; evict lru; preempt lifo; }
pool reqs { cap max_seqs; }

stage engine : step {
  budget B;
  chunk chunk_cap;
  cost c0 + max(omega + beta * (kvb + kvp), ntok * a);
  memory kv;
}
stage tool : delay;
stage delegate : delay;

// --8<-- [start:workload]
// An arrival is a subagent with probability kids / (1 + kids), so the
// stream carries both at the rate the parents would create them. A
// subagent starts from a context of its own: the parent's context it
// copies is not shared across sessions (docs/language.md §9).
workload {
  arrive poisson(Lambda * (1 + kids));
  init {
    set sub = ~bernoulli(kids / (1 + kids));
    set K = sub ? ~uniform(2000, 6000) : 0;
    set t_s = now;
  }
  turn {
    set n = K == 0 ? ~uniform(1000, 3000) : ~exp(500);
    set o = ~exp(200) + 1;
    set more = ~bernoulli(sub ? pc : p);
    set fan = sub ? 0 : ~bernoulli(q);
  }
  session {
    turn;
    loop {
      request;
      set K = prompt + o;
      branch (more) {
        branch (fan) { run delegate (W); } else { tool (~exp(Z)); }
        turn;
      } else {
        branch (sub) { observe subagent = now - t_s; }
        end;
      }
    }
  }
}
// --8<-- [end:workload]

server {
  set t0 = now;
  set prompt = K + n;
  // the prefix hit (full blocks, never the whole prompt) is looked up when
  // the scheduler admits (scheduler.py:932-939), and the admission takes the
  // hit plus the chunk the budget allows (scheduler.py:1078-1128, 1214-1226);
  // docs/language.md §7 "Admission" has the argument.
  // `known` is every token the request has: the prompt, or after a
  // preemption the position it had reached plus the token sampled there
  // (vLLM keeps the generated tokens and drops only their KV,
  // scheduler.py:1560-1561); the hit can cover all but the last of them
  admit if reqs (1), kv (min(known, hit + budget_left(engine))) fit
        where known = computed < prompt ? prompt : computed + 1,
              hit = min(cachedin(kv), floor((known - 1) / bs) * bs) {
    set known = computed < prompt ? prompt : computed + 1;
    set c = min(cached, floor((known - 1) / bs) * bs);
    observe hit = c > 0;
    observe prefill_tokens = known - c;
    prefill (known - c) growing kv;
    branch (known == prompt) { observe ttft = now - t0; }   // not a resumed request's re-prefill
    decode (o - 1 - (known - prompt)) growing kv;
  } keep (prompt + o);
  observe response = now - t0;
}

run { horizon 2000; warmup 200; seed 1; }
