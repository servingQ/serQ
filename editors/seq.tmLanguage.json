{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "seQ",
  "scopeName": "source.seq",
  "fileTypes": [
    "seq"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#distributions"
    },
    {
      "include": "#structure"
    },
    {
      "include": "#statements"
    },
    {
      "include": "#options"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.seq",
          "match": "//.*$"
        },
        {
          "name": "comment.block.seq",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.seq",
      "begin": "\"",
      "end": "\""
    },
    "distributions": {
      "match": "(~)([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "constant.character.escape.seq"
        },
        "2": {
          "name": "constant.character.escape.seq"
        }
      }
    },
    "structure": {
      "name": "keyword.other.declaration.seq",
      "match": "\\b(let|pool|stage|workload|session|server|run)\\b"
    },
    "statements": {
      "name": "entity.name.function.seq",
      "match": "\\b(turn|request|set|observe|hold|enter|admit|if|fit|where|grow|drop|branch|with|loop|choose|end|reserve|reuse|cache|keep|at|admission|growing|on|in|by|else|prefill|transfer|decode|tool)\\b"
    },
    "options": {
      "name": "support.type.property-name.seq",
      "match": "\\b(cap|block|evict|lru|preempt|lifo|none|queue|fifo|admit|via|spill|when|ps|delay|step|budget|cost|chunk|serve|exclusive|first|memory|arrive|poisson|closed|batch|trace|ordered|init|horizon|warmup|seed)\\b"
    },
    "builtins": {
      "name": "variable.language.seq",
      "match": "\\b(busy|work|used|free|cachedin|holders|queued|price|budget_left|est_lambda|est_rho|est_wait|now|size|age|last|ntok|ndec|npre|nres|kvb|kvp|attn|cached|serial|turn_no|new|out|think|more|forced)\\b"
    },
    "numbers": {
      "name": "constant.numeric.seq",
      "match": "\\b\\d+\\.?\\d*([eE][-+]?\\d+)?\\b"
    },
    "operators": {
      "name": "keyword.operator.seq",
      "match": "[-+*/^<>=!&|?:]+"
    }
  }
}
