// SGLang (ref/sglang at b792228b) on one device, its defaults: FCFS, no
// mixed chunk, prefill first (docs/design/engine-neutrality.md cites the
// source rule by rule):
//
// - an iteration forms a prefill batch of the chunked request and every
//   waiting request the budget and memory take, and runs it alone; with no
//   prefill to run it runs the decode batch (the body);
// - the admission test subtracts what every running request may still
//   generate, scaled by `new_token_ratio`, which decays each decode step,
//   jumps after a retraction and resets when the server goes idle (the
//   register `ratio`);
// - a retraction takes, from the decode batch, the request with the fewest
//   output tokens, then the longest prompt, and sends it to the back of the
//   queue (`preempt by … requeue tail`).
//
// Where this program is not SGLang: the admission test sums one request's
// estimate times the running count, where SGLang sums each request's own
// remaining `max_new_tokens`; after a retraction the ratio is set to the
// bound `20 / M` the survivors' outputs raise, which needs their sum; the
// radix cache is shared across requests, and serQ's entries are a
// session's own (#374).
let B = 8192;           // chunked_prefill_size
let max_run = 256;      // max_running_requests
let tokens_cap = 60000; // max_total_num_tokens (page size 1)
let M = 2048;           // the clients' max_new_tokens
let clip = 4096;        // SGLANG_CLIP_MAX_NEW_TOKENS_ESTIMATION
let r0 = 0.7;           // SGLANG_INIT_NEW_TOKEN_RATIO times schedule_conservativeness 1.0
let r_min = 0.7 * 0.14; // times SGLANG_MIN_NEW_TOKEN_RATIO_FACTOR
let r_decay = (0.7 - 0.7 * 0.14) / 600;   // over SGLANG_NEW_TOKEN_RATIO_DECAY_STEPS
let a = 2e-5;           // compute per scheduled token (s)
let omega = 2e-4;       // weights read per iteration (s)
let beta = 2e-9;        // KV read per iteration per resident context token (s)
let Lambda = 0.5;       // sessions per second
let p = 0.9;            // continue after a turn
let Z = 3.0;            // tool time (s)

pool reqs { cap max_run; admit via engine; }
pool kv { cap tokens_cap; evict lru; preempt by (1 - decoding, position - prompt, -prompt) requeue tail; }

stage engine : step {
  budget B;
  cost max(omega + beta * (kv_decode + kv_prefill), tokens * a);
  memory kv;
  state ratio = r0;
  iteration {
    branch (residents == 0) { set ratio = r0; }       // idle: reset
    serve only (!decoding);                            // the chunked request
    admit;                                             // and new prefills, alone
    branch (tokens == 0) {                             // no prefill: a decode batch
      serve;
      branch (preempted > 0) { set ratio = min(1, 20 / M); } else { set ratio = max(r_min, ratio - r_decay); }
    }
  }
}
stage tool : delay;

workload {
  arrive poisson(Lambda);
  hidden o;
  init { set K = 0; }
  turn {
    set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
    set o = min(M, floor(~exp(200)) + 1);
    set more = ~bernoulli(p);
  }
  session {
    turn;
    loop {
      request;
      set K = prompt + o;
      branch (more) { tool (~exp(Z)); turn; } else { end; }
    }
  }
}

// A retracted request keeps its output tokens and recomputes them; only its
// prompt stays in the cache (`fin` is 0 until the request finishes). The
// reservation grows with the running requests, as SGLang's test does; above
// the cap, the request waits for some to finish (#364).
server {
  set t0 = now;
  set prompt = K + n;
  set fin = 0;
  hold reqs (1), kv (min(known, hit + budget_left(engine)))
       reserve (known - hit + min(M - (known - prompt), clip) + 1
                + ratio * min(M, clip) * holders(reqs))
       at admission (known = computed < prompt ? prompt : computed + 1,
                     hit = min(cachedin(kv), known - 1)) {
    set c = min(cached, known - 1);
    prefill on engine (known - c) growing kv;
    branch (known == prompt) { observe ttft = now - t0; }
    decode on engine (o - 1 - (known - prompt)) growing kv;
    set fin = 1;
  } cache (fin == 1 ? prompt + o : prompt);
  observe response = now - t0;
}

run { horizon 2000; warmup 200; seed 1; }
