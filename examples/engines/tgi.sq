// Hugging Face TGI v3 (ref/tgi at b4adbf2f) on one device, its default
// path: flashinfer attention, block size 1, prefix caching and prefill
// chunking on (docs/design/engine-neutrality.md cites the source). A
// forward that admits is one mixed batch: the residents' decodes and
// prefill chunks, then new requests FCFS into the prefill budget left, the
// last one chunked; the loop then decodes once more before it looks at the
// queue again, so the forward after one that admitted admits nothing (the
// register `just`). A request is admitted with blocks for its whole input
// plus max_new_tokens, so nothing grows and nothing is preempted. The
// prefix cache keeps the prompt only, a session's own here (#374). TGI's
// other path (no chunking) forms a new batch only when enough requests wait
// or enough decode steps have passed, and prefills it in a forward of its
// own: the body sketched in docs/design/engine-neutrality.md (a guard on
// `queued(kv)`, a counter register, `serve` only when nothing was
// admitted), with `granule inf`.

let B = 4096;          // max_batch_prefill_tokens
let T = 200000;        // max_batch_total_tokens (set by warm-up; assumed)
let mnt = 1024;        // the clients' max_new_tokens
let a = 2e-5;          // compute per scheduled token (s)
let omega = 2e-4;      // weights read per iteration (s)
let beta = 2e-9;       // KV read per iteration per resident context token (s)
let Lambda = 0.3;      // sessions per second
let p = 0.9;           // continue after a turn
let Z = 3.0;           // tool time (s)

fn main() {
  device gpu { compute (t) = t * a; hbm (k) = omega + beta * k; kv cap T; }
  engine tgi on gpu {
    tokens cap B;
    state just = 0;                // the last forward admitted
    // with no running batch there is no decode forward, and the queue is read
    schedule {
      advance running;
      branch (just == 0 || running.count == 0) { admit waiting; }
      set just = waiting.admitted > 0;
    }
    execute (max(hbm(batch.kv_decode + batch.kv_prefill), compute(batch.tokens)));
  }
  pool kv on tgi.gpu { block 1; evict lru; preempt none; }
  stage tool : delay;

  workload {
    arrive poisson(Lambda);
    hidden o;
    init { set K = 0; }
    turn {
      set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
      set o = min(floor(~exp(300)) + 1, mnt);
      set more = ~bernoulli(p);
    }
    session {
      loop {
        turn;
        set K = prompt + o;
        branch (more) { tool (~exp(Z)); } else { end; }
      }
    }
  }

  // The hit never covers the whole input; only the input is cached.
  server {
    set t0 = now;
    set prompt = K + n;
    hold kv (cost(kv, prompt + mnt - 1)) reuse (cost(kv, prompt - 1)) {
      set c = cached;
      run tgi prefill (cost(tgi, prompt - c));
      observe ttft = now - t0;
      run tgi decode (cost(tgi, o - 1));
    } cache (cost(kv, prompt));
    observe response = now - t0;
  }


}
