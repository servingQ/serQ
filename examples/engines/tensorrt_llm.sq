// TensorRT-LLM (ref/TensorRT-LLM at bf414e37), PyTorch backend on a dense
// model, its defaults: the C++ capacity scheduler under
// GUARANTEED_NO_EVICT, then the micro-batch scheduler with chunked prefill
// off and block reuse on. The closest program serQ writes today;
// docs/design/engine-neutrality.md cites the source rule by rule and says
// where this program is not TensorRT-LLM:
//
// - a request is admitted only if the free blocks, less what every running
//   request still needs to reach prompt + max_tokens, cover its own
//   prompt + max_tokens. serQ's `reserve` is a test at admission that
//   nothing keeps, so the program allocates the whole reservation at once:
//   the admissions are the same, but `used` counts blocks TensorRT-LLM has
//   not allocated yet and the cache is evicted earlier;
// - no chunking: a context runs whole or waits. serQ's `chunk` is a cap,
//   so the `reserve` on `reqs` stands in: with too little budget left it
//   asks for the whole request cap, which only an empty engine gives;
// - prefix-aware scheduling skips a context whose first blocks a context
//   admitted in the same pass will contribute: the cache here is a
//   session's own, so this program is strict FCFS;
// - the overlap scheduler schedules iteration n+1 before it reads n's
//   samples, so a request that stops at n is in n+1's batch: `decode (o)`.
def reusable(x, bs) = floor((x - 1) / bs) * bs;

let B = 8192;            // max_num_tokens
let max_batch = 2048;    // max_batch_size
let blocks = 10000;      // KV blocks
let bs = 32;             // tokens_per_block
let mt = 1024;           // max_tokens, known to the scheduler
let a = 2e-5;            // compute per scheduled token (s)
let omega = 2e-4;        // weights read per iteration (s)
let beta = 2e-9;         // KV read per iteration per resident context token (s)
let Lambda = 0.3;        // sessions per second
let p = 0.9;             // continue after a turn
let Z = 3.0;             // tool time (s)

pool kv { cap blocks * bs; block bs; evict lru; preempt none; }
pool reqs { cap max_batch; admit via engine; }

stage engine : step {
  budget B;
  cost max(omega + beta * (kv_decode + kv_prefill), tokens * a);
  memory kv;
}
stage tool : delay;

workload {
  arrive poisson(Lambda);
  hidden o;
  init { set K = 0; }
  turn {
    set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
    set o = min(floor(~exp(200)) + 1, mt);
    set more = ~bernoulli(p);
  }
  session {
    turn;
    loop {
      request;
      set K = prompt + o;
      branch (more) { tool (~exp(Z)); turn; } else { end; }
    }
  }
}

server {
  set t0 = now;
  set prompt = K + n;
  // whole or wait, spelled as a slot reservation (docs/design/engine-neutrality.md, `granule`)
  hold reqs (1) reserve (budget_left(engine) >= prompt - hit ? 1 : max_batch),
       kv (prompt + mt)
       at admission (hit = min(cachedin(kv), reusable(prompt, blocksize(kv)))) {
    set c = min(cached, reusable(prompt, blocksize(kv)));
    prefill on engine (prompt - c);
    observe ttft = now - t0;
    decode on engine (o);
  } cache (prompt + o - 1);
  observe response = now - t0;
}

run { horizon 2000; warmup 200; seed 1; }
