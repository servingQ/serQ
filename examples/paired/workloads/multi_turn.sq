// Agent sessions: a prompt on the context so far, a tool call between
// turns (examples/multi-turn/vllm.sq's workload). A workload file: no
// `fn main()`, paired with a deployment by the tool (`--workload`).
use "std/args";

let p = 0.9;  // continue after a turn
let Lambda = args.number("Lambda", 0.3);  // sessions per second
let Z = args.number("Z", 3.0);  // tool time (s)

workload {
  arrive poisson(Lambda);
  init { set K = 0; }
  turn {
    set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
    set o = floor(~exp(200)) + 1;
    set more = ~bernoulli(p);
  }
  send (input: K + n, output: o);
  session {
    turn;
    while (more) {
      set K = K + n + o;
      tool (~exp(Z));
      turn;
    }
  }
}
