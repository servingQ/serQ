// FCFS lanes from vllm-ascend v0.27.1rc1: immediate, aged long, short, long.
// This full-attention example models local admission, not job prediction or remote KV.
let short_tokens = 128;
let max_wait = 0.003;
def waiting_class(urgent, prompt, elapsed) {
  urgent ? 0 : prompt > short_tokens && max_wait > 0 && elapsed >= max_wait ? 1 : prompt <= short_tokens ? 2 : 3
}

fn main() {
  workload {
    arrive batch(6);
    turn {
      set prompt = serial == 1 || serial == 5 ? 256 : 64;
      set immediate = serial == 4;
      set out = serial == 0 ? 4 : 1;
    }
  }
  device npu { kv cap 4096; }
  engine llm on npu {
    reqs cap 1;
    tokens cap 128;
    schedule {
      advance running each at most (128);
      admit waiting while (running.preempted == 0) each at most (128);
    }
    execute (0.001);
  }
  pool reqs on llm { queue by (waiting_class(immediate, prompt, waited)); }
  pool kv on npu { block 16; }
  stage delay : delay;
  server {
    run delay (cost(delay, serial == 2 ? 0.001 : serial == 3 ? 0.002 : serial >= 4 ? 0.003 : 0));
    hold reqs (cost(reqs, 1)), kv (cost(kv, prompt + out)) {
      observe selected = serial;
      observe admitted = now;
      run llm prefill (cost(llm, prompt));
      run llm decode (cost(llm, out));
    }
    observe response = now;
  }
}
