// Full-attention approximation for the backend-selected 64-token block path.
// Shared prefixes, recovery, and async execution are not modelled.
pool kv { cap 8192; block 64; evict lru; }
pool reqs { cap 4; admit via engine; }
stage engine : step { budget 256; chunk 128; cost 0.001 + 0.00001 * tokens; memory kv; }
workload {
  arrive batch(6);
  init { set prompt = 256; set out = 16; }
}
session {
  set t0 = now;
  hold reqs (1), kv (prompt + out) {
    prefill prompt;
    observe ttft = now - t0;
    decode out;
  }
  observe response = now - t0;
  end;
}
run { horizon 2; warmup 0; seed 1; }
