// vllm-rbln's RBLNScheduler (v0.11.3a21) on one NPU, approximated.
// docs/use-cases/rbln.md explains it a part at a time.
fn main() {
  // --8<-- [start:engine]
  device npu { kv cap 8192; }
  engine llm on npu {
    reqs cap 4;
    tokens cap 256;
    // --8<-- [end:engine]
    // --8<-- [start:schedule]
    scheduler {
      exclusive prefill each at most (128);
      admit waiting while (running.preempted == 0) each at most (128)
        taking reqs (1), kv (min(request.known, request.hit + min(128, budget_left(llm))))
          reserve (request.known)
        reuse (floor(request.known - 1, blocksize(kv)))
        cache (request.input + request.output - 1);
    }
    worker {
      forward (0.002 + 0.00001 * batch.tokens);
    }
  }
  // --8<-- [end:schedule]
  // --8<-- [start:pools]
  pool kv on npu { block 16; evict lru; preempt lifo; }
  pool reqs on llm { queue fifo; }
  // --8<-- [end:pools]
  // --8<-- [start:workload]
  workload {
    arrive batch(6);
    init { set prompt = 256; set out = 16; }
  }
  server {
    llm (prompt, out + 1);   // the model's `out` decode steps after the prefill's token
  }
  // --8<-- [end:workload]
}
