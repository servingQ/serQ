// Executable approximation: one prefill or a decode-only batch.
// PP caps, remote-KV admission and sub-block copying are not modeled.
// The native RBLNScheduler keeps vLLM's prefix cache: a waiting request
// looks up its hit and the step's blocks are cached once it is final, and a
// failed allocation preempts the last running request under FCFS
// (docs/use-cases/rbln.md links the lines at tag v0.11.3a21).
fn main() {
  device npu { kv cap 8192; }
  engine llm on npu {
    reqs cap 4;
    tokens cap 256;
    // What the RBLN scheduler does with one request, as vLLM does: prefill
    // what the cache does not hold and decode. A preempted request keeps
    // the tokens it generated (`kept`) and prefills them again.
    request (prompt, output) {
      set kept = prompt;
      at admission {
        known = max(kept, computed + 1);
        left = budget_left(llm);
        reused = min(cachedin(kv), floor(known - 1, blocksize(kv)));
      }
      set kept = known;
      set c = min(cached, floor(known - 1, blocksize(kv)));
      prefill (known - c) growing kv;
      decode (output - (known - prompt)) growing kv;
      cache (prompt + output);
    }
    schedule {
      exclusive prefill each at most (128);
      // the reused prefix plus a chunk of at most 128, if the whole
      // sequence fits
      admit waiting while (running.preempted == 0) each at most (128)
        taking reqs (1), kv (min(known, reused + min(128, left))) reserve (known);
    }
    execute (0.002 + 0.00001 * batch.tokens);
  }
  pool kv on npu { block 16; evict lru; preempt lifo; }
  pool reqs on llm { queue fifo; }
  workload {
    arrive batch(6);
    init { set prompt = 256; set out = 16; }
  }
  server {
    llm (prompt, out);
  }
}
