// Prefill/decode disaggregation on two nodes, with the KV moved over two
// fabrics: a decoder on the prefiller's node reads it over NVLink, one on
// the other node over RDMA. Each node holds NPn prefill and NDn decode
// GPUs; P[i] is on node floor(i / NPn), D[j] on node floor(j / NDn).
//
// A read holds a port at each end at once: the prefiller's and the
// decoder's NVLink port, or its NIC and theirs. The two fabrics share no
// stage, so each divides its ports among its reads by its own policy
// (docs/design/fabric-share.md). Neither policy is a measurement: the A6000
// testbed (docs/design/bandwidth-sharing.md, What is not verified) moved
// its KV inside one node and cannot tell them apart. They are written apart
// so that a measurement on two nodes can fit each fabric on its own. At
// the bandwidths below the reads seldom overlap, and the report is the same
// whichever fabric takes which policy; `--BwNV` and `--BwRDMA` load them.
//
// The engines are reduced to their service times: a prefiller computes one
// prompt at a time, a decoder decodes with room to spare, and its KV pool
// is what bounds it. examples/pd-disaggregation/llmd_nixl_pull.sq has the
// engines and the router of a deployment; this program has its fabrics.
// Its workload: examples/workloads/pd_two_fabrics.sq.
use "std/args";
use "std/share";

let NPn = 2;           // prefill GPUs per node
let NDn = 2;           // decode GPUs per node
let NP = 2 * NPn;      // prefill GPUs on the two nodes
let ND = 2 * NDn;      // decode GPUs on the two nodes
let a = 2e-5;          // prefill compute per prompt token (s)
let tok = 2e-3;        // decode time per output token (s)
let capD = 1e5;        // KV tokens a decoder holds
let x0 = 0.002;        // wait before an RDMA read: posting it and polling its completion (s)

fn main() {
  let BwNV = args.number("BwNV", 2e6);        // an NVLink port, tokens/s (128 KB per token at 256 GB/s)
  let BwRDMA = args.number("BwRDMA", 2e5);    // a NIC, tokens/s (128 KB per token at 25 GB/s)

  pool kvP[NP] { cap inf; }       // a prefiller's KV, leased until the decoder has read it
  pool kvD[ND] { cap capD; }
  stage P[NP] : fifo;             // a prefill engine, one prompt at a time
  stage D[ND] : delay;            // a decode engine, with room to spare
  stage nvl_out[NP] : ps(BwNV);   // a prefiller's NVLink port
  stage nvl_in[ND] : ps(BwNV);    // a decoder's
  stage nic_out[NP] : ps(BwRDMA); // a prefiller's NIC
  stage nic_in[ND] : ps(BwRDMA);  // a decoder's

  server (n, o) {
    set t0 = now;
    choose i in NP by (work(P[i]));
    hold kvP[i] (cost(kvP, n)) { run P[i] (cost(P, n * a)); } lease kvP[i] (inf);
    choose j in ND by (holders(kvD[j]) + queued(kvD[j]));
    hold kvD[j] (cost(kvD, n + o)) {
      set t1 = now;
      if (floor(i / NPn) == floor(j / NDn)) {
        // the same node: NVLink, each read its equal share at the tighter
        // of its two ports, the rest of the other left unused
        transfer on nvl_out[i], nvl_in[j] (n, share = share.bottleneck) from kvP[i] to kvD[j] (n);
        observe nvlink_read = now - t1;
      } else {
        // across the nodes: RDMA, the NICs divided max-min fairly, after
        // the wait before each read
        transfer on nic_out[i], nic_in[j] (n, share = share.maxmin, latency = x0) from kvP[i] to kvD[j] (n);
        observe rdma_read = now - t1;
      }
      run D[j] (cost(D, o * tok));
    }
    observe response = now - t0;
  }
}
