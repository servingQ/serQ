// The idealisation pd_batching.sq is measured against (#208): decode as
// processor sharing at a constant fraction of an engine. Colocated, each
// of N engines gives its decodes the fraction f of its time and takes a
// random N-th of the requests; split, N f decode engines share all of
// them as one station of capacity N f. The split is the colocated
// station with the arrival rate and the capacity both multiplied by N:
// the number decoding at a station is the same, and the time each request
// spends decoding is divided by N — by 1/f when N f = 1.
//
// This is an identity of the model, not a property of an engine: an
// engine does not give its decodes a constant fraction of its time, and a
// decode step does not slow down in proportion to the decodes it carries.
// pd_batching.sq runs the steps; this program is what they are compared to.
let N = 4;             // colocated engines
let f = 0.25;          // fraction of an engine's time its decodes get
let mode = 1;          // 0 colocated, 1 split
let Lambda = 15.0;     // requests per second (load Lambda E[o - 1] tok / (N f) = 0.6)
let tok = 2e-4;        // time of one decode token at a whole engine (s)

// the law, by name (`--def output='201'`)
def output() = floor(~exp(200)) + 2;

stage colo[N] : ps(f);
stage dec : ps(N * f);

workload {
  arrive poisson(Lambda);
  init {
    set o = output();
    set k = floor(~uniform(0, N));   // a Poisson stream split at random is Poisson
  }
}

session {
  set t0 = now;
  branch (mode == 0) { run colo[k] ((o - 1) * tok); } else { run dec ((o - 1) * tok); }
  observe decode_time = now - t0;
  observe tpot = (now - t0) / (o - 1);
  observe output_tokens = o;
  end;
}

run { horizon 300; warmup 30; seed 1; }
