// Aggregated pool vs prefill -> KV link -> decode tandem
// (`libqueuingsim::models::pd`, paper App. B, `prop:pd`). `jobs` requests
// circulate (saturated load): the throughput is the capacity
// N/(s_P + s_D + I) aggregated, min(N_P g_P/s_P, N_D g_D/s_D, B/K) split.
let N = 32;
let NP = 11;
let sP = 1.0;
let sD = 1.0;
let I = 0.5;
let gP = 2.0;
let gD = 1.0;
let bnet = 1000.0;
let K = 1.0;
let jobs = 320;
let mode = 1;   // 0 aggregated, 1 disaggregated

stage agg : fifo(max(N, 1));
stage prefill : fifo(max(NP, 1));
stage link : fifo;
stage decode : fifo(max(N - NP, 1));

workload { arrive closed(jobs); }

session {
  loop {
    set t0 = now;
    set sp = ~exp(sP);
    set sd = ~exp(sD);
    set kv = ~exp(K);
    branch (mode == 0) {
      run agg (sp + sd + I);
    } else {
      run prefill (sp / gP);
      run link (kv / bnet);
      run decode (sd / gD);
    }
    observe latency = now - t0;
  }
}

run { horizon 20000; warmup 2000; seed 1; }
