// Aggregated pool vs prefill -> KV link -> decode tandem
// (`libqueuingsim::models::pd`, paper App. B, `prop:pd`). `jobs` requests
// circulate (saturated load): the throughput is the capacity
// N/(s_P + s_D + I) aggregated, min(N_P g_P/s_P, N_D g_D/s_D, B/K) split.

let N = 32;
let NP = 11;
let sP = 1.0;
let sD = 1.0;
let I = 0.5;
let gP = 2.0;
let gD = 1.0;
let bnet = 1000.0;
let K = 1.0;
let jobs = 320;
let mode = 1;   // 0 aggregated, 1 disaggregated

// the laws, by name (`--def prefill_work='~erlang(4, sP)'`)
def prefill_work() { ~exp(sP) }
def decode_work() { ~exp(sD) }
def kv_tokens() { ~exp(K) }

fn main() {
  stage agg : fifo(max(N, 1));
  stage prefill : fifo(max(NP, 1));
  stage link : fifo;
  stage decode : fifo(max(N - NP, 1));

  workload {
    arrive closed(jobs);
    session { request;
    }
  }

  server {
    loop {
      set t0 = now;
      set sp = prefill_work();
      set sd = decode_work();
      set kv = kv_tokens();
      branch (mode == 0) {
        run agg (cost(agg, sp + sd + I));
      } else {
        run prefill (cost(prefill, sp / gP));
        run link (cost(link, kv / bnet));
        run decode (cost(decode, sd / gD));
      }
      observe latency = now - t0;
    }
  }


}
