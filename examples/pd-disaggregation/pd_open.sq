// Open-arrival aggregated pool vs prefill -> KV link -> decode tandem.

let N = 32;
let NP = 11;
let Lambda = 1.0;
let sP = 1.0;
let sD = 1.0;
let I = 0.5;
let gP = 2.0;
let gD = 1.0;
let bnet = 1000.0;
let K = 1.0;
let mode = 1; // 0 aggregated, 1 disaggregated

// the laws, by name (`--def prefill_work='~erlang(4, sP)'`)
def prefill_work() { ~exp(sP) }
def decode_work() { ~exp(sD) }
def kv_tokens() { ~exp(K) }

fn main() {
  stage agg : fifo(max(N, 1));
  stage prefill : fifo(max(NP, 1));
  stage link : fifo;
  stage decode : fifo(max(N - NP, 1));

  workload {
    arrive poisson(Lambda);
    session { request; end; }
  }

  server {
    set t0 = now;
    set sp = prefill_work();
    set sd = decode_work();
    set kv = kv_tokens();
    branch (mode == 0) {
      run agg (sp + sd + I);
    } else {
      run prefill (sp / gP);
      run link (kv / bnet);
      run decode (sd / gD);
    }
    observe latency = now - t0;
  }

  run { horizon 20000; warmup 2000; seed 1; }
}
