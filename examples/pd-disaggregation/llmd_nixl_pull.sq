// Prefill/decode disaggregation as llm-d runs it on vLLM, the KV handed over by NIXL in pull mode.
// docs/use-cases/pd.md explains it a part at a time.
use "std/args";
use "std/kvt";
use "std/share";

// --8<-- [start:settings]
let NP = 2;
let ND = 2;
let B = 8192;
let max_seqsP = 16;
let max_seqsD = 64;
let blocksP = 10000;
let bs = 16;
let max_model_len = 16384;
let a = 2e-5;
let omega = 2e-4;
let beta = 2e-9;
let c0 = 0;
let BwP = 2e5;
let BwD = 2e5;
let x0 = 0.002;
let minp = 0;
let p = 0.9;
let Z = 3.0;

fn main() {
  let blocksD = args.number("blocksD", 10000);
  let thr = args.number("thr", 512);
  let Lambda = args.number("Lambda", 0.6);
  // --8<-- [end:settings]

  // --8<-- [start:router]
  queue gw : gateway {
    route {
      set prompt = K + n;
      choose j in ND by (holders(D[j].kv) + queued(D[j].kv));
      set hitD = min(cachedin(D[j].kv), floor(prompt - 1, bs));
      set remote_prefill = prompt >= minp && prompt - hitD >= thr;
      if (remote_prefill) {
        choose i in NP by (cachedin(P[i].kv) > 0 ? 0 : 1, work(P[i]) + queued(P[i].reqs));
        P[i].prefill (prompt);
        set t1 = now;
        D[j].decode (prompt) from P[i];
        observe lease = D.read_done - t1;
      } else {
        D[j].decode (prompt);
      }
      observe remote = remote_prefill;
    }
  }
  // --8<-- [end:router]

  // --8<-- [start:prefiller]
  queue P[NP] : prefill {
    device gpu { compute (t) = t * a; hbm (k) = omega + beta * k; kv cap blocksP * bs; }
    engine on gpu {
      reqs cap max_seqsP;
      tokens cap B;
      schedule { advance running; admit waiting while (running.preempted == 0); }
      execute (c0 + max(hbm(batch.kv_decode + batch.kv_prefill), compute(batch.tokens)));
    }
    pool reqs on P { queue fifo; }
    pool kv on gpu { block bs; evict lru; preempt lifo; }
    nic ps(BwP);
    prefill (prompt) {
      hold reqs (cost(reqs, 1)), kv (cost(kv, min(prompt, reused + budget_left(P)))) reserve (cost(kv, prompt))
           at admission (reused = min(cachedin(kv), floor(prompt - 1, bs))) {
        set c = cached;
        run P prefill (cost(P, prompt - c)) growing kv;
      } cache (cost(reqs, kv, prompt)) lease kv (inf);
    }
  }
  // --8<-- [end:prefiller]

  // --8<-- [start:decoder]
  queue D[ND] : decode {
    device gpu { compute (t) = t * a; hbm (k) = omega + beta * k; kv cap blocksD * bs; }
    engine on gpu {
      reqs cap max_seqsD;
      tokens cap B;
      schedule { advance running; admit waiting while (running.preempted == 0); }
      execute (c0 + max(hbm(batch.kv_decode + batch.kv_prefill), compute(batch.tokens)));
    }
    pool reqs on D { queue fifo; }
    pool kv on D.gpu { block bs; evict lru; preempt lifo; }
    nic ps(BwD);
    // --8<-- [end:decoder]

    // --8<-- [start:local]
    decode (prompt) {
      set produced = min(o, max_model_len - prompt);
      set kept = prompt;
      hold kv (cost(kv, min(known, reused + budget_left(D)))) reserve (cost(kv, known)), reqs (cost(reqs, 1))
           at admission (known = max(kept, computed + 1),
                         reused = min(cachedin(kv), floor(known - 1, bs))) {
        set kept = known;
        set c = min(cached, floor(known - 1, bs));
        observe local_tokens = known - c;
        run D prefill (cost(D, known - c)) growing kv;
        run D decode (cost(D, produced - 1 - (known - prompt))) growing kv;
      } cache (cost(kv, reqs, prompt + produced));
    }
    // --8<-- [end:local]

    // --8<-- [start:remote]
    decode (prompt) from P {
      set produced = min(o, max_model_len - prompt);
      set transferred = 0;
      set kept = prompt;
      hold kv (cost(kv, known)) reserve (cost(kv, known)), reqs (cost(reqs, 0)) reserve (cost(reqs, 1))
           reuse (cost(kv, reqs, floor(known - 1, bs)))
           at admission (known = max(kept, computed + 1)) {
        set kept = known;
        set c = cached;
        if (!transferred) {
          observe remote_tokens = prompt - c;
          transfer (prompt - c) from P to kv (prompt - 1 - c);
          mark read_done;
          set transferred = 1;
          set c = prompt - 1;
        }
        hold reqs (cost(reqs, 1)) {
          run D prefill (cost(D, known - c)) growing kv;
          run D decode (cost(D, produced - 1 - (known - prompt))) growing kv;
        }
      } cache (cost(kv, reqs, prompt + produced));
    }
  }
  // --8<-- [end:remote]

  // --8<-- [start:transfer]
  kvt.nixl_pull (P, D, latency = x0, share = share.maxmin);
  // --8<-- [end:transfer]

  // --8<-- [start:workload]
  workload {
    arrive poisson(Lambda);
    hidden o;
    init { set K = 0; }
    turn {
      set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
      set o = floor(~exp(200)) + 1;
      set more = ~bernoulli(p);
    }
    session {
      turn;
      while (more) {
        set K = prompt + D.produced;
        tool (~exp(Z));
        turn;
      }
    }
  }
  // --8<-- [end:workload]

  // --8<-- [start:server]
  server {
    observe too_long = K + n >= max_model_len;
    if (K + n >= max_model_len) { end; }
    gw.route();
  }
  // --8<-- [end:server]

  // --8<-- [start:gauges]
  gauge running_spread = max k in ND (used(D[k].reqs)) - min k in ND (used(D[k].reqs));
  gauge kv_usage_max = max k in ND (used(D[k].kv) / (used(D[k].kv) + free(D[k].kv)));
  gauge kv_usage_mean = sum k in ND (used(D[k].kv) / (used(D[k].kv) + free(D[k].kv))) / ND;
  gauge load_spread = max k in ND (holders(D[k].kv) + queued(D[k].kv))
                    - min k in ND (holders(D[k].kv) + queued(D[k].kv));
  // --8<-- [end:gauges]
}
