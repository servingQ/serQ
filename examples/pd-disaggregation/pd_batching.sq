// The same requests on the same N engines, colocated or split: does
// disaggregation shorten the time between tokens without serving more?
// (#208, serving-queue-theory#28). A colocated engine spends its time on
// prefill steps and decode steps, and its decodes advance only in the
// latter; a decode engine runs nothing else, so its decodes step every
// iteration and each step carries the decodes of more requests.
//
// The engines are examples/pd-disaggregation/llmd_nixl_pull.sq's, without
// its prefix cache: a slot and the blocks of the first chunk at admission
// (the scheduler's, at a step), room for the whole prompt reserved, the KV
// grown token by token, the last admitted preempted when it does not fit,
// and a preempted request recomputing what it had. The split hands the KV
// over as llm-d does: the prefiller samples a token the client never sees
// and keeps its blocks leased until the decoder has read them; the decoder
// takes the request when the whole prompt fits its blocks, reads all of it
// but the last token over both NICs, and recomputes that token, which is
// the client's first (vLLM's NIXL proxy streams the decoder's answer,
// tests/v1/kv_connector/nixl_integration/toy_proxy_server.py:166-243). The
// read and the decoder's admission are in the TTFT.
//
// The baseline (#208): exclusive steps on the engines that prefill prompts
// (one prefill alone, or decodes only; a waiting prefill goes first), memory that never binds, a free and
// instantaneous transfer, no specialisation. Each is a constant here, or
// a line: `blocks*`, `Bw`, `x0`, `gP`, `gD`; mixed batches are this file
// with `serve exclusive prefill;` deleted, and another split is this file
// with another `NP` (tools/pd_batching/sweep.py writes both).
//
// `mode = 0` sends every request to one of the N colocated engines;
// `mode = 1` to one of NP prefill engines, then one of ND decode engines,
// the least busy of each. Both modes draw the same requests from a seed.
// The queues of the other mode are declared and stay idle.
let N = 4;             // colocated engines
let NP = 3;            // prefill engines when split
let ND = N - NP;       // decode engines when split: the same engines
let mode = 1;          // 0 colocated, 1 split
let B = 8192;          // max_num_batched_tokens
let chunk_cap = 0;     // long_prefill_token_threshold (0: none)
let max_seqs = 1024;   // max_num_seqs: enough that it never binds
let bs = 16;           // block_size
let blocksE = 1e6;     // num_gpu_blocks of a colocated engine
let blocksP = 1e6;     // of a prefill engine
let blocksD = 1e6;     // of a decode engine
let a = 2e-5;          // compute per scheduled token (s)
let omega = 2e-4;      // weights read per iteration (s)
let beta = 2e-9;       // KV read per iteration per resident context token (s)
let c0 = 0;            // fixed cost per iteration (s)
let gP = 1;            // a prefill engine's compute against a colocated one's
let gD = 1;            // a decode engine's memory bandwidth against a colocated one's
let Bw = 1e15;         // NIC bandwidth, tokens/s (2e5: 128 KB per token at 25 GB/s)
let x0 = 0;            // wait before every read (s)
let Lambda = 60.0;     // requests per second

// the laws, by name (`--def output='1001'`)
def prompt_len() = floor(~uniform(1000, 3000));
def output() = floor(~exp(200)) + 2;   // at least two tokens, so a TPOT exists

queue gw : gateway {
  route {
    set t0 = now;
    set prompt = n;
    branch (mode == 0) {
      choose j in N by (holders(E[j].reqs) + queued(E[j].kv));   // a request waits at the blocks
      E[j].decode (prompt);
      set first = E.first_token;
    } else {
      choose i in NP by (holders(P[i].reqs) + queued(P[i].reqs));
      P[i].prefill (prompt);
      set prefilled = P.prefilled;
      // a request parked for its read holds blocks, not a running slot
      choose j in ND by (holders(D[j].kv) + queued(D[j].kv));
      D[j].decode (prompt) from P[i];
      set first = D.first_token;
      observe admit_wait = D.admitted - prefilled;  // the decoder's admission: the prompt's blocks
      observe transfer = D.read_done - D.admitted;  // the read: the wait before it and both NICs
      observe lease = D.read_done - prefilled;      // how long the prefiller's blocks stayed leased
    }
    observe ttft = first - t0;
    observe decode_time = now - first;
    observe tpot = (now - first) / (o - 1);
    observe response = now - t0;
    observe output_tokens = o;
  }
}

// A colocated engine: the prompt and the answer on one device.
queue E[N] : decode {
  pool reqs { cap max_seqs; admit via E; }
  pool kv { cap blocksE * bs; block bs; evict lru; preempt lifo; admit via E; }
  serve step {
    budget B;
    chunk chunk_cap;
    cost c0 + max(omega + beta * (kv_decode + kv_prefill), tokens * a);
    memory kv;
    serve exclusive prefill;
  }
  decode (prompt) {
    hold kv (min(known, budget_left(E))) reserve (known), reqs (1)
         at admission (known = computed < prompt ? prompt : computed + 1) {
      prefill (known) growing kv;
      branch (known == prompt) { mark first_token; }   // not a resumed request's re-prefill
      decode (o - 1 - (known - prompt)) growing kv;
    }
  }
}

// A prefill engine: the prompt, and a token the client never sees; its
// blocks stay leased until the decoder has read them. A request reserves
// its whole prompt at admission (scheduler_reserve_full_isl), so it is
// never preempted here.
queue P[NP] : prefill {
  pool reqs { cap max_seqs; admit via P; }
  pool kv { cap blocksP * bs; block bs; evict lru; }
  serve step {
    budget B;
    chunk chunk_cap;
    cost c0 + max(omega + beta * (kv_decode + kv_prefill), tokens * a / gP);
    memory kv;
    serve exclusive prefill;
  }
  nic ps(Bw);
  prefill (prompt) {
    hold reqs (1), kv (min(prompt, budget_left(P))) reserve (prompt) {
      prefill (prompt) growing kv;
      mark prefilled;
    } lease kv (inf);
  }
}

// A decode engine: the request is taken when its prompt fits the blocks,
// waits for the read without a running slot, then decodes. A request
// preempted here recomputes what it lost.
queue D[ND] : decode {
  pool reqs { cap max_seqs; admit via D; }
  pool kv { cap blocksD * bs; block bs; evict lru; preempt lifo; admit via D; }
  serve step {
    budget B;
    chunk chunk_cap;
    cost c0 + max((omega + beta * (kv_decode + kv_prefill)) / gD, tokens * a);
    memory kv;
    // no exclusive steps: the one prompt token a decoder recomputes rides
    // with the decodes, as in vLLM
  }
  nic ps(Bw);
  // The `decode` role asks for this entry; the gateway never calls it.
  decode (prompt) {
    hold kv (min(known, budget_left(D))) reserve (known), reqs (1)
         at admission (known = computed < prompt ? prompt : computed + 1) {
      prefill (known) growing kv;
      decode (o - 1 - (known - prompt)) growing kv;
    }
  }
  decode (prompt) from src {
    set transferred = 0;
    hold kv (known) reserve (known), reqs (0) reserve (1)
         at admission (known = computed < prompt ? prompt : computed + 1) {
      set c = 0;
      branch (!transferred) {
        mark admitted;
        transfer (prompt) from src to kv (prompt - 1);   // over P's NIC and this pod's
        mark read_done;
        set transferred = 1;
        set c = prompt - 1;
      }
      // a running slot and a token of budget: the last prompt token
      // recomputed for its logits, or what a preemption lost
      hold reqs (1) {
        prefill (known - c) growing kv;
        branch (known == prompt) { mark first_token; }
        decode (o - 1 - (known - prompt)) growing kv;
      }
    }
  }
}

// How concurrent reads divide the two NICs is the fabric's, not vLLM's:
// max-min fairness is the model (docs/design/bandwidth-sharing.md).
D pull P latency x0 share maxmin;

workload {
  arrive poisson(Lambda);
  hidden o;              // the scheduler knows max_tokens, not the length
  turn {
    set n = prompt_len();
    set o = output();
  }
  session { turn; request gw; end; }
}

run { horizon 300; warmup 30; seed 1; }
