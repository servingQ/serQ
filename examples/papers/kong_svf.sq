// Kong et al., Smallest Volume First (arXiv 2606.22327) §3, as a serQ program.
// docs/use-cases/kong.md explains it a part at a time.

// --8<-- [start:settings]
let N = 200;
let M = 20000;
let P = 2500;
// --8<-- [end:settings]

fn main() {
  // --8<-- [start:workload]
  workload {
    arrive batch(N);
    init {
      set s = floor(~uniform(100, 2000));
      set o = floor(~uniform(10, 500));
    }
  }
  // --8<-- [end:workload]

  // --8<-- [start:memory]
  pool kv { cap M; queue by (s * o + floor((o * o + o) / 2)); }
  // --8<-- [end:memory]

  // --8<-- [start:engine]
  device gpu { }
  engine llm on gpu {
    tokens cap 1000000;
    request (output) { decode (output); }
    schedule { advance running; admit waiting while (running.preempted == 0); }
    execute (1);
  }
  // --8<-- [end:engine]

  // --8<-- [start:server]
  server {
    observe output_tokens = o;
    observe vol = s * o + floor((o * o + o) / 2);
    hold kv (cost(kv, s + o)) { llm (o); }
    observe response = now;
  }
  // --8<-- [end:server]

  // --8<-- [start:claim]
  claim queueing_bound given (s + o <= P && o >= 1):
    at end ((M - P) * (total(response) - total(output_tokens)) <= 2 * (prefix_total(vol) - total(vol)));
  // --8<-- [end:claim]
}
