// Dai et al., FasterTransformer's scheduler in the basic LLM queueing model
// (arXiv 2504.07347 §4). docs/use-cases/dai.md explains it.

let bmax = 128;
let c = 1128;
let a = 3547;
let b0 = 128;
let gap = 46750;
let vp = 290;
let vd = 990;

fn main() {
  device gpu { compute (t) = a * ceil(t / b0); }
  // --8<-- [start:engine]
  def in_phase() { running.decoding > 0 ? decoding : !decoding }
  engine fastertransformer on gpu {
    tokens cap bmax;
    scheduler {
      advance running only (in_phase());
      admit waiting only (in_phase()) while (running.preempted == 0);
    }
    worker {
      forward (c + compute(batch.tokens));
    }
  }
  // --8<-- [end:engine]

  workload {
    arrive renewal(gap);
    init { set t0 = now; }
  }

  server {
    fastertransformer (vp, vd + 1);   // the model's decode steps after the prefill's sampled token
    observe response = now - t0;
  }

  // --8<-- [start:not_work_conserving]
  claim not_work_conserving: some iteration of fastertransformer (demand >= bmax && tokens < bmax);
  // --8<-- [end:not_work_conserving]
  claim token_rate: every iteration of fastertransformer (served * (c + a * bmax / b0) <= bmax * now);
}
