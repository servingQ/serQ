// Dai, Deng, Li, Peng (arXiv 2504.07347) §4: FasterTransformer's scheduler
// in the basic LLM queueing model, at the operating point of
// `dai_sarathi.sq`. Decode first and no mixed batches: while a request
// decodes, an iteration batches only decodes and the prefills wait. Time is
// in units of 10 µs.
fn main() {
  let bmax = 128;
  let c = 1128;
  let a = 3547;
  let b0 = 128;
  let gap = 46750;
  let vp = 290;
  let vd = 990;

  stage engine : step {
    budget bmax;
    cost c + a * ceil(tokens / b0);
    serve only (decoders > 0 ? decoding : !decoding);
  }

  workload {
    arrive renewal(gap);
    init { set t0 = now; }

    session { request; end; }
  }

  server {
    run engine prefill (vp);
    run engine decode (vd);
    observe response = now - t0;
  }

  // §4: FasterTransformer is not work-conserving. Some batch is not full
  // although the residents could fill it.
  claim not_work_conserving: some iteration of engine (demand >= bmax && tokens < bmax);

  // Theorem 2(a) holds for it as for every scheduler.
  claim token_rate: every iteration of engine (served * (c + a * bmax / b0) <= bmax * now);

  run { horizon 5000000; warmup 0; seed 1; }
}
