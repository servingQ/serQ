// Dai et al., Sarathi-Serve in the basic LLM queueing model (arXiv 2504.07347),
// as a serQ program. docs/use-cases/dai.md explains it a part at a time;
// its workload is examples/workloads/dai_periodic.sq.

// --8<-- [start:settings]
let bmax = 128;  // token budget b_max
let c = 1128;  // t_b = c + a ceil(b / b0), 10 µs
let a = 3547;
let b0 = 128;  // b0 divides b_max (the paper's Assumption 1)
let vp = 290;
let vd = 990;
// --8<-- [end:settings]

fn main() {
  // --8<-- [start:engine]
  device gpu { compute (t) = a * ceil(t / b0); }
  engine sarathi on gpu {
    tokens cap bmax;
    scheduler {
      advance running admission;
      admit waiting while (running.preempted == 0);
    }
    worker {
      forward (c + compute(batch.tokens));
    }
  }
  // --8<-- [end:engine]

  // --8<-- [start:server]
  server (t0) {
    sarathi (vp, vd + 1);   // the model's decode steps after the prefill's sampled token
    observe response = now - t0;
  }
  // --8<-- [end:server]

  // --8<-- [start:work_conserving]
  claim work_conserving: every iteration of sarathi (demand < bmax || tokens == bmax);
  // --8<-- [end:work_conserving]

  // --8<-- [start:token_rate]
  claim token_rate: every iteration of sarathi (served * (c + a * bmax / b0) <= bmax * now);
  // --8<-- [end:token_rate]

  // --8<-- [start:bounded]
  claim bounded: every iteration of sarathi (arrived * (vp + vd) <= served + (bmax + 1) * (vp + vd));
  // --8<-- [end:bounded]
}
