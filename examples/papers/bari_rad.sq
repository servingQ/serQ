// Bari, Hegde, de Veciana, "Optimal Scheduling Algorithms for LLM
// Inference: Theory and Practice" (arXiv 2508.01002, POMACS 9(3) 2025): one
// inference node running RAD (Algorithm 1, the cycle parameter N taken
// infinite). The output and reduction tiles are b_col = b_row = b_red = 128,
// so b_lcm = 128. The batch time is (7) without its attention terms: a pass
// over each output tile and the non-linear operations per token. Time is in
// µs.
//
// RAD is in Decode Mode when b_col requests decode (|D| = b_col) or none is
// left to prefill (P empty), and decodes every one of them; otherwise it is
// in Prefill Mode and runs a chunk of b_lcm tokens of the oldest prefill.
// A prefill completes only in Prefill Mode, so |D| never exceeds b_col: the
// b_col active requests of Assumption 4.
use "std/args";

let bcol = 128;          // b_col = b_row = b_red = b_lcm
let tlin = 4000;         // µs per pass over a tile, 1 / c_Lin
let tnl = 5;             // µs per token of non-linear operations, 1 / c_nLin
let vpmax = 8;           // prompts are 1 .. vpmax tiles (Assumption 3)
let vdmax = 512;         // the largest output

fn main() {
  let rate = args.number("rate", 0.00002);      // requests per µs (20 per second)

  stage E : step {
    budget bcol;
    chunk bcol;
    cost tlin * ceil(tokens / bcol) + tnl * tokens;
    serve only (decoders >= bcol || decoders == residents ? decoding : !decoding);
  }

  workload {
    arrive poisson(rate);
    init {
      set t0 = now;
      set vp = bcol * floor(~uniform(1, vpmax + 1));
      set vd = min(floor(~exp(200)) + 1, vdmax);
    }

    session { request; end; }
  }

  server {
    run E prefill (cost(E, vp));
    run E decode (cost(E, vd));
    observe response = now - t0;
  }

  // Theorem 1: under any scheduler a node completes at most one token per
  // tlin / bcol + tnl µs, so a load above it diverges.
  claim token_rate: every iteration of E (served * (tlin + tnl * bcol) <= bcol * now);

  // Optimal GeMM tiling (§4.2): with prompts a multiple of b_lcm (Assumption 3),
  // every batch fills its tile, unless every request decodes and fewer than
  // b_col of them do.
  claim optimal_tiling given (vp == bcol * floor(vp / bcol)):
    every iteration of E (tokens == bcol || decoders == residents);


}
