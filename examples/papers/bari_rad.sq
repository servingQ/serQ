// Bari, Hegde, de Veciana (arXiv 2508.01002): one inference node running RAD.
// docs/use-cases/bari.md explains it a part at a time.
use "std/args";

// --8<-- [start:settings]
let bcol = 128;  // b_col = b_row = b_red = b_lcm
let tlin = 4000;  // µs per pass over a tile, 1 / c_Lin
let tnl = 5;  // µs per token of non-linear operations, 1 / c_nLin
let vpmax = 8;  // prompts are 1 .. vpmax tiles (Assumption 3)
let vdmax = 512;  // the largest output

fn main() {
  let rate = args.number("rate", 0.00002);  // requests per µs (20 per second)
  // --8<-- [end:settings]

  // --8<-- [start:engine]
  device gpu { }
  def in_mode() { running.decoding >= bcol || running.decoding == running.count ? decoding : !decoding }
  engine E on gpu {
    tokens cap bcol;
    scheduler {
      advance running only (in_mode()) each at most (bcol);
      admit waiting only (in_mode()) while (running.preempted == 0) each at most (bcol);
    }
    // --8<-- [end:engine]
    // --8<-- [start:worker]
    worker {
      forward (tlin * ceil(batch.tokens / bcol) + tnl * batch.tokens);
    }
  }
  // --8<-- [end:worker]

  // --8<-- [start:workload]
  workload {
    arrive poisson(rate);
    init {
      set t0 = now;
      set vp = bcol * floor(~uniform(1, vpmax + 1));
      set vd = min(floor(~exp(200)) + 1, vdmax);
    }
  }

  server {
    E (vp, vd + 1);   // the model's decode steps after the prefill's sampled token
    observe response = now - t0;
  }
  // --8<-- [end:workload]

  // --8<-- [start:claims]
  claim token_rate: every iteration of E (served * (tlin + tnl * bcol) <= bcol * now);

  claim optimal_tiling given (vp == bcol * floor(vp / bcol)):
    every iteration of E (tokens == bcol || decoders == residents);
  // --8<-- [end:claims]
}
