// One vLLM v1 request on the step clock: the program of the vLLM scheduler
// oracle (tools/oracle/*.json, tests/vllm_oracle.rs) and, compiled to IR,
// of the Lean theorems about it (lean/Serq/Oracle.lean).
// The constants are a scenario's engine; the requests are the workload
// instance, given as explicit sessions in the IR (prompt, o, arrive).
use "std/args";

fn main() {
  let bs = args.number("bs", 16);           // block_size
  let B = args.number("B", 1024);          // max_num_batched_tokens
  let blocks = args.number("blocks", 999);      // num_gpu_blocks less the null block
  let max_seqs = args.number("max_seqs", 16);     // max_num_seqs
  let chunk = args.number("chunk", inf);       // long_prefill_token_threshold (inf: none)

  device gpu { kv cap blocks * bs; }
  engine vllm on gpu {
    reqs cap max_seqs;
    tokens cap B;
    scheduler {
      // long_prefill_token_threshold binds only while another request is
      // running or waiting; a request alone takes the whole budget (scheduler.py:606-616)
      let threshold = running.count + waiting.count > 1 ? chunk : inf;
      advance running each at most (threshold);
      // the scheduler admits with the blocks of the chunk the budget the
      // running requests leave allows, if the whole sequence fits
      // (scheduler_reserve_full_isl: `request.num_tokens`, prompt and
      // generated tokens, kv_cache_manager.py:515-531), and grows from there
      admit waiting while (running.preempted == 0) each at most (threshold)
        taking reqs (1), kv (min(request.known, budget_left(vllm))) reserve (request.known);
    }
    worker {
      forward (1);
    }
  }
  pool reqs on vllm { queue fifo; }
  pool kv on gpu { block bs; evict lru; preempt lifo; }
  stage gate : delay;

  workload {
    arrive batch(1);
    init { set prompt = 1; set o = 1; set arrive = 0; }
    send (prompt, o);
    session { run gate (cost(gate, arrive)); turn; }
  }

  // the scheduler knows max_tokens, not the length (sched/utils.py:98-119)
  server (prompt, hidden o) {
    // a preempted request keeps its generated tokens and only its computed
    // KV is dropped (scheduler.py:1560-1561): admitted again, it recomputes
    // every token it has and generates only what is left; its first token
    // is sampled when its prompt is computed
    vllm (prompt, o);
    observe first = vllm.first;
    observe done = now;
  }
}
