// vLLM v1 serving agents that delegate to subagents, approximated: serQ has
// no statement that creates a session (docs/design/subagents.md), so the
// subagents arrive as sessions of their own in the same Poisson stream,
// and a parent waits for them at a delay stage for `W`, the time the
// slowest of its subagents took in a previous run. The engine is
// `examples/multi-turn/vllm.sq`'s line for line (docs/use-cases/workloads.md).
// `--q 0` is the same agents without subagents. The sessions:
// examples/workloads/subagents.sq.
use "std/args";

let B = 8192;  // max_num_batched_tokens
let bs = 16;  // block_size
let a = 2e-5;  // compute per scheduled token (s)
let omega = 2e-4;  // weights read per iteration (s)
let beta = 2e-9;  // KV read per iteration per resident context token (s)
let c0 = 0;  // fixed cost per iteration (s)

fn main() {
  let max_seqs = args.number("max_seqs", 16);     // max_num_seqs
  let blocks = args.number("blocks", 10000);    // num_gpu_blocks (less the null block)
  let chunk_cap = args.number("chunk_cap", inf);   // long_prefill_token_threshold (inf: none)

  device gpu {
    compute (t) = t * a;
    hbm (k) = omega + beta * k;
    kv cap blocks * bs;
  }
  pool kv on gpu { block bs; evict lru; preempt lifo; }
  engine vllm on gpu {
    reqs cap max_seqs;
    tokens cap B;
    scheduler {
      let threshold = running.count + waiting.count > 1 ? chunk_cap : inf;
      advance running each at most (threshold);
      admit waiting while (running.preempted == 0) each at most (threshold)
        taking reqs (1), kv (min(request.known, request.hit + budget_left(vllm)))
          reserve (request.known)
        reuse (floor(request.known - 1, blocksize(kv)))
        cache (request.input + request.output);
    }
    worker {
      forward (c0 + max(hbm(batch.kv_decode + batch.kv_prefill), compute(batch.tokens)));
    }
  }
  pool reqs on vllm { queue fifo; }

  // the scheduler knows max_tokens, not the length (sched/utils.py:98-119)
  server (input, hidden output) {
    vllm (input, output);
  }
}
