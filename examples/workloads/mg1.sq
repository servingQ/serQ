// Poisson turns at rate `lam`, i.i.d. service of mean `mean_s` drawn by
// `law` (0 deterministic, 1 exponential, 2 Erlang-4, 3 balanced H2 with
// `cv2`), or by any law given as `--def service=...`
// (examples/single-turn/mg1.sq runs it).
use "std/args";

let mean_s = 1.0;
let lam = args.number("lam", 0.8);
let cv2 = args.number("cv2", 4.0);
let law = args.number("law", 1);

def service() {
  law == 0 ? mean_s
  : law == 1 ? ~exp(mean_s)
  : law == 2 ? ~erlang(4, mean_s)
  : ~h2(mean_s, cv2)
}

workload {
  arrive poisson(lam);
  init {
    set t0 = now;
    set s = service();
  }
  send (s, t0);
}
