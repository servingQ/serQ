// A person's multi-turn chat: the person reads the answer, types a short
// follow-up, and sends the whole conversation back
// (examples/multi-turn/vllm.sq runs it, docs/use-cases/workloads.md).

let Lambda = 0.3;      // conversations per second
let p = 0.8;           // the person asks again
let Z = 20.0;          // reading and typing time (s)

// --8<-- [start:workload]
// Each turn resends the conversation so far (`K`) with a short message;
// the gap between turns is the person's.
workload {
  arrive poisson(Lambda);
  init { set K = 0; }
  turn {
    set n = ceil(K == 0 ? ~uniform(200, 1000) : ~exp(100));
    set o = floor(~exp(300)) + 1;
    set more = ~bernoulli(p);
  }
  send (input: K + n, output: o);
  session {
    turn;
    while (more) {
      set K = K + n + o;
      sleep (~exp(Z));  // the person reads and types
      turn;
    }
  }
}
// --8<-- [end:workload]
