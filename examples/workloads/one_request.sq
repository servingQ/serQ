// One request of a one-token prompt and one output token, sent at time
// `arrive` (examples/oracle/vllm_request.sq runs it): the shape of the
// oracle's sessions, which the IR lists in its place.

workload {
  arrive batch(1);
  init { set prompt = 1; set o = 1; set arrive = 0; }
  send (prompt, o);
  session { sleep (arrive); turn; }  // sent at `arrive`
}
