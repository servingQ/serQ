// The short-context trace replayed, each turn sending its previous prompt
// and output too, and whether it is forced (examples/replay/vllm_replay.sq
// runs it).
use "std/args";

let spacing = args.number("spacing", 3.5);     // seconds between session arrivals
let N = args.number("N", 333);           // sessions in the trace

// The client: the trace's sessions, sent `spacing` apart; a turn is sent
// `think` seconds after the previous one completes.
workload {
  arrive batch(N);
  trace "../replay/data/short_base.csv" ordered;
  send (new, forced, prev, prevout, out);
  session {
    sleep (serial * spacing);  // the session's first turn, `spacing` after the previous session's
    set prev = 0;
    set prevout = 0;
    turn;
    while (more) {
      set prev = new;
      set prevout = out;
      sleep (think);  // the trace's gap
      turn;
    }
  }
}
