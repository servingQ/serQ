// examples/workloads/chat.sq's sessions, a session's context growing by the
// tokens the server reports it produced (`reply.produced`), which a
// too-long prompt cuts short (examples/pd-disaggregation/llmd_nixl_pull.sq
// runs it).
use "std/args";

let p = 0.9;  // continue after a turn
let Z = 3.0;  // tool time (s)
let Lambda = args.number("Lambda", 0.6);  // sessions per second

// --8<-- [start:workload]
workload {
  arrive poisson(Lambda);
  init { set K = 0; }
  turn {
    set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
    set o = floor(~exp(200)) + 1;
    set more = ~bernoulli(p);
  }
  send (input: K + n, output: o);
  session {
    turn;
    while (more) {
      set K = K + n + reply.produced;
      tool (~exp(Z));
      turn;
    }
  }
}
// --8<-- [end:workload]
