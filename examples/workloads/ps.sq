// Poisson turns at rate `lam`, i.i.d. service of mean `mean_s` drawn by
// `law` (0 deterministic, 1 exponential, 2 Erlang-4, 3 balanced H2 with
// `cv2`) (examples/single-turn/ps.sq runs it).

let lam = 0.7;
let mean_s = 1.0;
let cv2 = 9.0;
let law = 1;

workload {
  arrive poisson(lam);
  init {
    set s = law == 0 ? mean_s
          : law == 1 ? ~exp(mean_s)
          : law == 2 ? ~erlang(4, mean_s)
          : ~h2(mean_s, cv2);
  }
  send (s);
}
