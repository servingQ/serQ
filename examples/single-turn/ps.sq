// M/G/1 processor sharing (paper `prop:decode`, insensitivity): the mean
// number in the station is rho/(1-rho) whatever the service law.

let lam = 0.7;
let mean_s = 1.0;
let cv2 = 9.0;
let law = 1;

fn main() {
  stage svc : ps(1);

  workload {
    arrive poisson(lam);
    init {
      set t0 = now;
      set s = law == 0 ? mean_s
            : law == 1 ? ~exp(mean_s)
            : law == 2 ? ~erlang(4, mean_s)
            : ~h2(mean_s, cv2);
    }

    session { request; end; }
  }

  server {
    run svc (s);
    observe response = now - t0;
  }


}
