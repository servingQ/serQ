// Whole-batch prefill isolation: B arrives while A is decoding.
// With unit step costs the selected batches are A:p2, B:p4, A:d1, A:d1.
// Removing the serve clause allows mixed A:d1+B:p3 and A:d1+B:p1.
fn main() {
  stage gate : delay;
  device gpu { kv cap 20; }
  engine llm on gpu {
    reqs cap 2;
    tokens cap 4;
    schedule {
      exclusive prefill each at most (4);
      admit waiting while (running.preempted == 0) each at most (4);
    }
    execute (1);
  }
  pool reqs on llm { queue fifo; }
  pool kv on gpu { }
  workload {
    arrive batch(2);
    init { set prompt = serial == 0 ? 2 : 4; }

  }
  server {
    run gate (cost(gate, serial));
    set t0 = now;
    hold reqs (cost(reqs, 1)), kv (cost(kv, min(prompt, left))) reserve (cost(kv, prompt))
         at admission (left = budget_left(llm)) {
      run llm prefill (cost(llm, prompt)) growing kv;
      observe ttft = now - t0;
      branch (serial == 0) { run llm decode (cost(llm, 2)) growing kv; }
    }
    observe response = now - t0;
  }

}
