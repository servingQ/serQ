// Whole-batch prefill isolation: B arrives while A is decoding.
// With unit step costs the selected batches are A:p2, B:p4, A:d1, A:d1.
// Writing `advance running` for `exclusive prefill` allows mixed A:d1+B:p3
// and A:d1+B:p1.
fn main() {
  stage gate : delay;
  device gpu { kv cap 20; }
  engine llm on gpu {
    reqs cap 2;
    tokens cap 4;
    scheduler {
      exclusive prefill each at most (4);
      admit waiting while (running.preempted == 0) each at most (4)
        taking reqs (1), kv (min(request.input, budget_left(llm))) reserve (request.input);
    }
    worker {
      forward (1);
    }
  }
  pool reqs on llm { queue fifo; }
  pool kv on gpu { }
  workload {
    arrive batch(2);
    init { set prompt = serial == 0 ? 2 : 4; }
    send (prompt);
  }
  server (prompt) {
    run gate (cost(gate, serial));
    set t0 = now;
    // A decodes two tokens after its prefill's; B only prefills
    llm (prompt, serial == 0 ? 3 : 1);
    observe gated_ttft = llm.first - t0;   // from the gate, B's arrival at the engine
    observe gated_response = now - t0;
  }
}
