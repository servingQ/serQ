// M/G/1 FIFO (paper §2, `prop:pk`): `servers` servers (one: M/G/1) fed
// examples/workloads/mg1.sq's Poisson turns of i.i.d. service.

let servers = 1;

fn main() {
  stage svc : fifo(servers);

  server (s, t0) {
    run svc (cost(svc, s));
    observe wait = now - t0 - s;
    observe service_time = s;
  }
}
