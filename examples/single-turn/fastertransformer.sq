// FasterTransformer's scheduler as Dai et al. model it (arXiv 2504.07347 §4).
// docs/use-cases/fastertransformer.md explains it a part at a time.
use "std/args";

// --8<-- [start:settings]
let kmax = 100;  // batch size limit k_max (§6)
let c = 11.28e-3;  // s
let a = 35.47e-3;  // s per step of b0 tokens
let b0 = 128;
let gap = 0.4675;  // fixed inter-arrival time (s)
let vp = 290;
let vd = 990;

fn main() {
  let bmax = args.number("bmax", 128);  // token budget b_max
  // --8<-- [end:settings]

  // --8<-- [start:slots]
  pool reqs { cap kmax; }
  // --8<-- [end:slots]

  // --8<-- [start:engine]
  device gpu { compute (t) = a * ceil(t / b0); }
  def in_phase() { running.decoding > 0 ? decoding : !decoding }
  engine fastertransformer on gpu {
    tokens cap bmax;
    request (prompt, output) {
      prefill (prompt);
      decode (output);
    }
    scheduler {
      advance running only (in_phase());
      admit waiting only (in_phase()) while (running.preempted == 0);
    }
    worker {
      forward (c + compute(batch.tokens));
    }
  }
  // --8<-- [end:engine]

  // --8<-- [start:workload]
  workload {
    arrive renewal(gap);
  }

  server {
    hold reqs (cost(reqs, 1)) { fastertransformer (vp, vd); }
  }

  gauge pending = holders(reqs) + queued(reqs);
  // --8<-- [end:workload]
}
