// One FIFO server. Under examples/workloads/closed.sq, a closed loop of N
// sessions with exponential work and think time, it is the M/M/1//N
// finite-source queue of paper `prop:finite` (mean value analysis).

fn main() {
  stage svc : fifo;

  server (s, t0) {
    run svc (cost(svc, s));
    observe wait = now - t0 - s;
  }
}
