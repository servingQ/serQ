// vLLM v1 serving agents whose sessions begin with a system prompt (the
// instructions and the tool schemas, S tokens) that other sessions of the
// same product send too. vLLM's prefix cache is keyed by content: a block's
// hash is its tokens and its parent's hash (kv_cache_utils.py:650-680), so
// a session finds the blocks of a system prompt another session computed,
// and a block several requests read is allocated once (`ref_cnt`,
// block_pool.py:754-768) and goes back to the free queue only when the last
// of them frees it (block_pool.py:776-796). The request says what its
// prompt is made of, its first item: `prefix (product: system, session:
// inf)`, the product's system prompt, then the session's own context. The
// engine is `vllm.sq`'s, the request's segments named; the workload is
// `vllm.sq`'s with a system prompt in front.
use "std/args";

let B = 8192;          // max_num_batched_tokens
let bs = 16;           // block_size
let a = 2e-5;          // compute per scheduled token (s)
let omega = 2e-4;      // weights read per iteration (s)
let beta = 2e-9;       // KV read per iteration per resident context token (s)
let c0 = 0;            // fixed cost per iteration (s)
let p = 0.9;           // continue after a turn

fn main() {
  let max_seqs = args.number("max_seqs", 16);     // max_num_seqs
  let blocks = args.number("blocks", 10000);    // num_gpu_blocks (less the null block)
  let chunk_cap = args.number("chunk_cap", inf);   // long_prefill_token_threshold (inf: none)
  let Lambda = args.number("Lambda", 0.3);      // sessions per second
  let Z = args.number("Z", 3.0);           // tool time (s)
  let S = args.number("S", 4000);          // tokens of a system prompt
  let M = args.number("M", 1);             // products, each with its own system prompt

  device gpu {
    compute (t) = t * a;
    hbm (k) = omega + beta * k;
    kv cap blocks * bs;
  }
  pool kv on gpu { block bs; evict lru; preempt lifo; }
  engine vllm on gpu {
    reqs cap max_seqs;
    tokens cap B;
    // `vllm.sq`'s request. Its prompt is the system prompt of `product`,
    // `system` tokens long, then the context of `session`: the cache reads
    // the first across sessions, the second within one. `known` is every
    // token it has (after a preemption, the position it had reached plus
    // the token sampled there, scheduler.py:1560-1561); `reused` is what
    // the prefix cache holds of it in full blocks, never the last token
    // (kv_cache_manager.py:289-300).
    request (prompt, output, product, system, session) {
      prefix (product: system, session: inf);
      set kept = prompt;
      at admission {
        known = max(kept, computed + 1);
        reused = min(cachedin(kv), floor(known - 1, blocksize(kv)));
      }
      set kept = known;
      set c = min(cached, floor(known - 1, blocksize(kv)));
      observe reused_tokens = c;
      observe prefill_tokens = known - c;
      prefill (known - c) growing kv;
      decode (output - 1 - (known - prompt)) growing kv;
      cache (prompt + output);                // a finished request's blocks stay cached
    }
    schedule {
      // long_prefill_token_threshold binds only while another request is
      // running or waiting; a request alone takes the whole budget (scheduler.py:606-616)
      let threshold = running.count + waiting.count > 1 ? chunk_cap : inf;
      advance running each at most (threshold);
      // vllm.sq's admission: the reused tokens plus the chunk the budget
      // allows, admitted only if every token fits (the `reserve`)
      admit waiting while (running.preempted == 0) each at most (threshold)
        taking reqs (1), kv (min(known, reused + budget_left(vllm))) reserve (known);
    }
    execute (c0 + max(hbm(batch.kv_decode + batch.kv_prefill), compute(batch.tokens)));
  }
  pool reqs on vllm { queue fifo; }   // the engine admits the waiting, FCFS

  // The client: `vllm.sq`'s sessions, each of one of M products chosen
  // uniformly; a prompt is the product's system prompt, the session's
  // context K and the turn's n new tokens.
  workload {
    arrive poisson(Lambda);
    hidden o;              // the scheduler knows max_tokens, not the length (sched/utils.py:98-119)
    init {
      set K = 0;
      set product = floor(~uniform(0, M));
    }
    turn {
      set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
      set o = floor(~exp(200)) + 1;
      set more = ~bernoulli(p);
    }
    session {
      turn;
      while (more) {
        set K = K + n + o;
        tool (~exp(Z));
        turn;
      }
    }
  }

  // A turn is one request to the engine.
  server {
    set prompt = S + K + n;
    vllm (prompt, o, product, S, serial);
  }
}
