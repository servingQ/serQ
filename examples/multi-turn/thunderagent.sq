// ThunderAgent (ThunderAgent-org/ThunderAgent at 7ddc861, its router in TR
// mode) in front of J vLLM replicas. docs/use-cases/thunderagent.md explains it.
use "std/args";

// --8<-- [start:settings]
let J = 2;             // vLLM replicas (--backends)
let B = 8192;          // max_num_batched_tokens
let max_seqs = 256;    // max_num_seqs
let bs = 16;           // block_size
let c0 = 0;            // fixed cost per iteration (s)
let buffer = 100;      // BUFFER_PER_PROGRAM: decode headroom per program (tokens)
let p = 0.9;           // the agent continues after a turn
let system = 0;        // the key of the system prompt every program shares
let force_resume = 1800;  // _wait_for_resume's timeout (s)

fn main() {
  let tr = args.number("tr", 1);             // 1: --router tr, 0: --router default
  let blocks = args.number("blocks", 4000);  // num_gpu_blocks of a replica
  let N = args.number("N", 32);              // agents at once
  let Z = args.number("Z", 3.0);             // mean tool time (s)
  let a = args.number("a", 2e-4);            // compute per scheduled token (s)
  let g = args.number("g", 0);               // prefill attention per token and context token (s)
  let omega = args.number("omega", 0.02);    // weights read per iteration (s)
  let beta = args.number("beta", 2e-7);      // KV read per iteration per resident context token (s)
  let S = args.number("S", 0);               // shared system prompt (tokens)
  let count_shared = args.number("count_shared", 1);  // 1: S in every program, 0: once
  let w = args.number("w", 1);               // --acting-token-weight
  let room = blocks * bs - (count_shared ? 0 : S);   // the router's capacity
  let dt = args.number("dt", 5);             // --scheduler-interval (s)
  let est = args.number("est", 0);           // the router's token estimate's relative error, at most
  // --8<-- [end:settings]

  // --8<-- [start:replica]
  queue E[J] : decode {
    device gpu { compute (t) = t * a; hbm (k) = omega + beta * k; kv cap blocks * bs; }
    engine on gpu {
      reqs cap max_seqs;
      tokens cap B;
      schedule { advance running; admit waiting while (running.preempted == 0); }
      execute (c0 + max(hbm(batch.kv_decode + batch.kv_prefill),
                        compute(batch.tokens) + g * batch.attention));
    }
    pool reqs on E { queue fifo; }
    pool kv on E.gpu { block bs; evict lru; preempt lifo; }
    decode (prompt) {
      set kept = prompt;
      hold kv (cost(kv, min(known, reused + budget_left(E)))) reserve (cost(kv, known)), reqs (cost(reqs, 1))
           prefix (system: S, serial: inf)
           at admission (known = max(kept, computed + 1),
                         reused = min(cachedin(kv), floor(known - 1, bs))) {
        set kept = known;
        set c = min(cached, floor(known - 1, bs));
        observe hit = c > S;
        observe reused_tokens = c;
        observe prefill_tokens = known - c;
        run E prefill (cost(E, known - c)) growing kv;
        run E decode (cost(E, o - 1 - (known - prompt))) growing kv;
      } cache (cost(kv, reqs, prompt + o));
    }
  }
  // --8<-- [end:replica]

  // --8<-- [start:workload]
  workload {
    arrive closed(N);
    hidden o;
    init { set K = 0; }
    turn {
      set n = ceil(K == 0 ? ~uniform(4000, 8000) : ~exp(1000));
      set o = floor(~exp(300)) + 1;
      set more = ~bernoulli(p);
    }
    session {
      turn;
      while (more) {
        set K = K + n + o;
        tool (~exp(Z));
        turn;
      }
    }
  }
  // --8<-- [end:workload]

  // --8<-- [start:waiting_queue]
  pool waiting_queue { queue by (K > 0 ? 0 : 1, charged) every (dt); }
  // --8<-- [end:waiting_queue]
  // --8<-- [start:prog]
  pool prog[J] {
    cap tr ? room : inf;
    preempt leases by (reasoning, prompt) every (dt) suspend by (prompt);
  }
  // --8<-- [end:prog]
  // --8<-- [start:helpers]
  def no_room(x) { max r in J (free(prog[r])) < x }
  def count_as(x) {
    if (x >= allocated(prog[home])) {
      grow prog[home] (cost(prog, x - allocated(prog[home])));
    } else {
      shrink prog[home] (cost(prog, allocated(prog[home]) - x));
    }
  }
  // --8<-- [end:helpers]

  // --8<-- [start:charge]
  server {
    set prompt = K + n;
    set charged = min(floor(prompt * (est > 0 ? ~uniform(1 - est, 1 + est) : 1)) + buffer
                      - (count_shared ? 0 : S), room);
    if (prompt + buffer >= blocks * bs) { end; }
    // --8<-- [end:charge]
    // --8<-- [start:running]
    set reasoning = 1;
    set placed = K > 0 && allocated(prog[home]) > 0;
    if (placed) {
      count_as(charged);
    } else {
      // --8<-- [end:running]
      // --8<-- [start:let_in]
      if (K > 0) { release prog[home]; }
      set t_q = now;
      set waits = tr && (K > 0 || queued(waiting_queue) > 0 || no_room(charged));
      while (waits) {
        hold waiting_queue (cost(waiting_queue, 1)) { }
        set waits = no_room(charged) && now - t_q < force_resume;
      }
      choose j in J by (tr ? (free(prog[j]) >= charged ? 0 : 1) : 0,
                        tr ? used(prog[j]) : holders(prog[j]));
      set home = j;
      hold prog[home] (cost(prog, tr ? buffer : charged)) {
        if (K > 0) { observe resume_wait = now - t_q; }
      } lease prog[home] (inf);
      if (tr) { count_as(charged); }
    }
    // --8<-- [end:let_in]
    // --8<-- [start:response]
    E[home].decode (prompt);
    set usage = min(prompt + o + buffer - (count_shared ? 0 : S), room);
    if (allocated(prog[home]) > 0) { count_as(usage); }
    if (w < 1 && allocated(prog[home]) > 0) {
      shrink prog[home] (cost(prog, (1 - w) * (allocated(prog[home]) - buffer)));
    }
    set reasoning = 0;
  }
  // --8<-- [end:response]
}
