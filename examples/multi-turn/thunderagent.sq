// ThunderAgent (ThunderAgent-org/ThunderAgent at 7ddc861, its router in TR
// mode) in front of J vLLM replicas, running a fixed number of agents at
// once, as a rollout or a benchmark run does. The router admits programs,
// not requests: a program (a session, by its `program_id`) is placed on a
// replica at its first request and stays there, and it counts against that
// replica's KV capacity while it reasons and while it calls a tool, so that
// a program coming back from its tool still finds its prefix in the
// replica's cache. A new program is let in only where its tokens fit;
// otherwise it waits. A running program whose tokens outgrow the replica
// pauses idle ones, which are let in again at their next request.
// docs/design/thunderagent.md has the correspondence, the paper's results
// beside this program's, and what this program does not write.
//
// `--tr 0` is the router's `default` mode: the replica with the fewest
// programs, no capacity. The model's constants are of the order of a 32B
// model on one GPU (an iteration of 20 ms), not a fit; the device's are
// arguments, so that tools/thunderagent/sweep.py can run the paper's scale.
use "std/args";

let J = 2;             // vLLM replicas (--backends)
let B = 8192;          // max_num_batched_tokens
let max_seqs = 256;    // max_num_seqs
let bs = 16;           // block_size
let c0 = 0;            // fixed cost per iteration (s)
let buffer = 100;      // BUFFER_PER_PROGRAM: decode headroom per program (tokens)
let p = 0.9;           // the agent continues after a turn

fn main() {
  let tr = args.number("tr", 1);             // 1: --router tr, 0: --router default
  let blocks = args.number("blocks", 4000);  // num_gpu_blocks of a replica
  let N = args.number("N", 32);              // agents at once
  let Z = args.number("Z", 3.0);             // mean tool time (s)
  let a = args.number("a", 2e-4);            // compute per scheduled token (s)
  let g = args.number("g", 0);               // prefill attention per token and context token (s)
  let omega = args.number("omega", 0.02);    // weights read per iteration (s)
  let beta = args.number("beta", 2e-7);      // KV read per iteration per resident context token (s)
  // The system prompt and tool descriptions every program starts with, in
  // tokens, a multiple of the block and below the shortest first prompt.
  // vLLM caches it once and every request reuses it; the router counts it
  // in every program's tokens (shared_tokens is never subtracted at
  // 7ddc861).
  let S = args.number("S", 0);
  // 1: the router counts the shared prompt in every program, as the code
  // does; 0: once, as the wiki's capacity, with shared_tokens subtracted
  let count_shared = args.number("count_shared", 1);
  let room = blocks * bs - (count_shared ? 0 : S);   // the router's capacity

  // A replica: vLLM's engine on one device, its prefix cache in the blocks,
  // examples/pd-disaggregation/llmd_nixl_pull.sq's local decoder without
  // its max_model_len cap. The
  // shared prompt's blocks stay cached: every request hits them, so the LRU
  // never reaches them. A request holds and caches only its own tokens
  // beyond them.
  queue E[J] : decode {
    device gpu { compute (t) = t * a; hbm (k) = omega + beta * k; kv cap blocks * bs - S; }
    engine on gpu {
      reqs cap max_seqs;
      tokens cap B;
      schedule { advance running; admit waiting while (running.preempted == 0); }
      // a prefill's attention over its context grows with the square of
      // what it recomputes (the paper's Eq. 8); every request also reads
      // and attends to the shared prompt
      execute (c0 + max(hbm(batch.kv_decode + batch.kv_prefill + S * batch.decoding),
                        compute(batch.tokens) + g * (batch.attention + S * batch.prefilled)));
    }
    pool reqs on E { queue fifo; }
    pool kv on E.gpu { block bs; evict lru; preempt lifo; }
    // `own` is every token the request has beyond the shared prompt.
    decode (prompt) {
      set kept = prompt - S;   // the most tokens an attempt had: a preemption keeps the outputs
      hold kv (cost(kv, min(own, reused + budget_left(E)))) reserve (cost(kv, own)), reqs (cost(reqs, 1))
           at admission (own = max(kept, computed + 1),
                         reused = min(cachedin(kv), floor(own - 1, bs))) {
        set kept = own;
        set c = min(cached, floor(own - 1, bs));
        observe hit = c > 0;                      // any block of the program's own
        observe reused_tokens = S + c;            // vLLM's prefix_cache_hits; with prefill_tokens, its queries
        observe prefill_tokens = own - c;
        run E prefill (cost(E, own - c)) growing kv;
        run E decode (cost(E, o - 1 - (own - (prompt - S)))) growing kv;
      } cache (cost(kv, reqs, prompt - S + o));
    }
  }

  // The agent: a task's first prompt, then a tool call and a short
  // observation per step. Nothing here is ThunderAgent's.
  workload {
    arrive closed(N);
    hidden o;              // the router knows the prompt, not the length of the answer
    init { set K = 0; }
    turn {
      set n = ceil(K == 0 ? ~uniform(4000, 8000) : ~exp(1000));
      set o = floor(~exp(300)) + 1;
      set more = ~bernoulli(p);
    }
    session {
      turn;
      while (more) {
        set K = K + n + o;
        tool (~exp(Z));
        turn;
      }
    }
  }

  // The router's picture of a replica: the tokens of the programs placed on
  // it, against vLLM's KV capacity (cache_config.total_tokens_capacity).
  // Waiting programs that already have a step go before new ones, the
  // smaller first in each (_greedy_resume's groups); one that has waited
  // 30 minutes goes first, as _wait_for_resume forces it in then. A program whose
  // tokens grow past the capacity pauses others: those calling a tool
  // first, then those reasoning, the smaller first in each
  // (_pause_until_safe). A paused program's tokens are no longer counted,
  // and its next request waits to be let in again.
  pool prog[J] {
    cap tr ? room : inf;
    queue by (waited < 1800, turn_no == 0, prompt);
    preempt leases by (reasoning, prompt);
  }

  // The router. A program's tokens are its prompt, the router's estimate
  // before the request (update_program_before_request), and they stay
  // counted through the tool call (acting_token_weight 1, the default): a
  // lease of `prog`. A running program's next request goes to its replica
  // at once, its count grown to the new prompt. A new or a paused program
  // goes to the replica with the fewest program tokens among those it fits
  // (_select_backend_for_new_program; a paused one may move,
  // _greedy_resume), and waits there when none has room; in default mode a
  // new one goes to the replica with the fewest programs. The program is
  // released when the session ends (/programs/release).
  server {
    set prompt = K + n;
    set charged = prompt + buffer - (count_shared ? 0 : S);   // the router's tokens of the program
    // vLLM refuses a prompt its KV cannot hold (max_model_len is at most
    // the KV, as in examples/pd-disaggregation/llmd_nixl_pull.sq): the
    // agent's trajectory ends there, in either mode
    branch (prompt + buffer >= blocks * bs) { end; }
    set reasoning = 1;
    set placed = K > 0 && allocated(prog[home]) > 0;
    branch (placed) {
      grow prog[home] (cost(prog, charged - allocated(prog[home])));
    } else {
      choose j in J by (tr ? (free(prog[j]) >= charged ? 0 : 1) : 0,
                        tr ? used(prog[j]) : holders(prog[j]));
      set home = j;
      set t_q = now;
      hold prog[home] (cost(prog, charged)) {
        branch (K > 0) { observe resume_wait = now - t_q; }
      } lease prog[home] (inf);
    }
    E[home].decode (prompt);
    // the response's usage counts the answer too (update_program_after_request),
    // up to what a replica holds
    branch (allocated(prog[home]) > 0) {
      grow prog[home] (cost(prog, min(o, room - allocated(prog[home]))));
    }
    set reasoning = 0;
  }
}
