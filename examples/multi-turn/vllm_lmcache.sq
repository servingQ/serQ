// vLLM v1 with an LMCache server as its L2 KV cache (LMCacheMPConnector,
// ref/vllm at 0c87a197, `vllm/distributed/kv_transfer/kv_connector/v1/
// lmcache_mp_connector.py`): `multi-turn/vllm.sq` with a second, larger
// cache outside the GPU. When the scheduler admits a request it asks the
// connector how much of the prompt the L2 holds past what the GPU's prefix
// cache holds (scheduler.py:940-952), and the connector answers in whole
// LMCache chunks, nothing for a preempted request
// (lmcache_mp_connector.py:758, 775, 788). The request keeps its blocks and
// waits outside the batch while that KV is copied in (scheduler.py:1069-1072,
// 1267), then computes the rest. Its computed KV goes back to the L2.
//
// What the model leaves out: LMCache stores each step's full chunks as they
// are computed (lmcache_mp_connector.py:296-366), and the program stores a
// request's once, when it ends, keeping its slot and blocks while it does;
// the copies do not slow the iteration they overlap; a lookup is never
// deferred to a later step; and the L2 entry is the session's, where LMCache
// keys a chunk by its tokens (docs/design/kv-transfer.md).
use "std/args";
use "std/kvt";

let B = 8192;          // max_num_batched_tokens
let bs = 16;           // block_size
let a = 2e-5;          // compute per scheduled token (s)
let omega = 2e-4;      // weights read per iteration (s)
let beta = 2e-9;       // KV read per iteration per resident context token (s)
let c0 = 0;            // fixed cost per iteration (s)
let p = 0.9;           // continue after a turn
let chunk = 256;       // LMCache's chunk: what it stores and finds, in tokens
let r = 5e-6;          // seconds per token at the server's bandwidth (128 KiB/token at ~25 GB/s)

fn main() {
  let max_seqs = args.number("max_seqs", 16);     // max_num_seqs
  let blocks = args.number("blocks", 2000);     // num_gpu_blocks: small, so that the GPU evicts
  let l2 = args.number("l2", 1e6);              // tokens the LMCache server holds
  let Lambda = args.number("Lambda", 0.3);      // sessions per second
  let Z = args.number("Z", 3.0);           // tool time (s)

  device gpu {
    compute (t) = t * a;
    hbm (k) = omega + beta * k;
    kv cap blocks * bs;
  }
  pool kv on gpu { block bs; evict lru; preempt lifo; }

  // The LMCache server: its memory, and the bandwidth the copies in and out
  // of it divide.
  queue lmc : cache {
    device host { kv cap l2; }
    pool kv on host { block chunk; evict lru; }
    serve ps(1);
  }

  // The whole chunks the L2 holds of `known` tokens past the `hit` the GPU
  // holds; nothing for a request once preempted (`fresh` is 0).
  def beyond(known, hit, fresh) {
    fresh ? max(0, min(floor(cachedin(lmc.kv), chunk), floor(known - 1, bs)) - hit) : 0
  }

  engine vllm on gpu {
    reqs cap max_seqs;
    tokens cap B;
    // `multi-turn/vllm.sq`'s request, and the L2: the admission allocates
    // the blocks the copy fills (`loaded`), and the body copies them in. The
    // body reads the L2 itself, at the instant it starts, which is the
    // admission's.
    request (prompt, output) {
      set kept = prompt;
      set fresh = 1;
      at admission {
        known = max(kept, computed + 1);
        reused = min(cachedin(kv), floor(known - 1, blocksize(kv)));
        loaded = beyond(known, reused, fresh);
      }
      set kept = known;
      set hit = min(cached, floor(known - 1, blocksize(kv)));
      set got = beyond(known, hit, fresh);
      set fresh = 0;
      kvt.l2_load (lmc, kv, got, per_token = r);
      set c = hit + got;
      observe l2_hit = got;
      observe prefill_tokens = known - c;
      prefill (known - c) growing kv;
      decode (output - 1 - (known - prompt)) growing kv;
      kvt.l2_store (kv, lmc, floor(prompt + output, chunk), per_token = r);
      cache (prompt + output);
    }
    schedule {
      advance running;
      admit waiting while (running.preempted == 0)
        taking reqs (1), kv (min(known, reused + loaded + budget_left(vllm))) reserve (known);
    }
    execute (c0 + max(hbm(batch.kv_decode + batch.kv_prefill), compute(batch.tokens)));
  }
  pool reqs on vllm { queue fifo; }

  workload {
    arrive poisson(Lambda);
    hidden o;
    init { set K = 0; }
    turn {
      set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
      set o = floor(~exp(200)) + 1;
      set more = ~bernoulli(p);
    }
    session {
      turn;
      while (more) {
        set K = K + n + o;
        tool (~exp(Z));
        turn;
      }
    }
  }

  server {
    set prompt = K + n;
    vllm (prompt, o);
  }
}
