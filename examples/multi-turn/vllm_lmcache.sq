// vLLM v1 with an LMCache server as its L2 KV cache (LMCacheMPConnector,
// vLLM v0.31.0, `vllm/distributed/kv_transfer/kv_connector/v1/
// lmcache_mp_connector.py`; the scheduler at ref/vllm 0c87a197, which
// v0.31.0 contains): `multi-turn/vllm.sq` with a second, larger
// cache outside the GPU. When the scheduler admits a request it asks the
// connector how much of the prompt the L2 holds past what the GPU's prefix
// cache holds (scheduler.py:941-954), and the connector answers in whole
// LMCache chunks, nothing for a preempted request
// (lmcache_mp_connector.py:758, 775, 788). The request is given blocks for
// that KV and none for new work (scheduler.py:1069-1072), waits while it is
// copied in, recomputes the last prompt token (scheduler.py:3075-3076), and
// computes the rest. Its computed KV goes back to the L2.
//
// What the model leaves out: LMCache stores each step's full chunks as they
// are computed (lmcache_mp_connector.py:296-366), and the program stores a
// request's once, when it ends, keeping its slot and blocks while it does;
// a request copying in keeps its slot and goes on to its prefill, where
// vLLM frees the slot and admits it again (scheduler.py:877-878,
// 3081-3091); the copies do not slow the iteration they overlap; a lookup
// is never deferred to a later step; and the L2 entry is the session's,
// where LMCache keys a chunk by its tokens (docs/design/kv-transfer.md).
use "std/args";

let B = 8192;          // max_num_batched_tokens
let bs = 16;           // block_size
let a = 2e-5;          // compute per scheduled token (s)
let omega = 2e-4;      // weights read per iteration (s)
let beta = 2e-9;       // KV read per iteration per resident context token (s)
let c0 = 0;            // fixed cost per iteration (s)
let p = 0.9;           // continue after a turn
let chunk = 256;       // LMCache's chunk: what it stores and finds, in tokens
let r = 5e-6;          // seconds per token at the server's bandwidth (128 KiB/token at ~25 GB/s)

fn main() {
  let max_seqs = args.number("max_seqs", 16);     // max_num_seqs
  let blocks = args.number("blocks", 2000);     // num_gpu_blocks: small, so that the GPU evicts
  let chunk_cap = args.number("chunk_cap", inf);   // long_prefill_token_threshold (inf: none)
  let l2_cap = args.number("l2_cap", 1e6);      // tokens the LMCache server holds
  let Lambda = args.number("Lambda", 0.3);      // sessions per second
  let Z = args.number("Z", 3.0);           // tool time (s)

  device gpu {
    compute (t) = t * a;
    hbm (k) = omega + beta * k;
    kv cap blocks * bs;
  }
  pool kv on gpu { block bs; evict lru; preempt lifo; }

  // The LMCache server: its memory, and the bandwidth the copies in and out
  // of it divide.
  queue lmc : l2 {
    device host { kv cap l2_cap; }
    pool kv on host { block chunk; evict lru; }
    serve ps(1);
  }

  // The whole chunks of `known` tokens the L2 holds past the `hit` the GPU
  // holds, all but the last token, which vLLM computes again after a full
  // copy.
  def beyond(known, hit) {
    max(0, min(floor(cachedin(lmc.kv), chunk), known - 1) - hit)
  }

  engine vllm on gpu {
    reqs cap max_seqs;
    tokens cap B;
    // The LMCache connector: at a request's admission, what the L2 holds
    // past the GPU's hit, nothing for a preempted request
    // (lmcache_mp_connector.py:758); at its end, its tokens in whole chunks,
    // its blocks kept until they are copied (lmcache_mp_connector.py:952).
    connector lmc {
      per_token (r);
      load (request.preempted ? 0 : beyond(request.known, request.hit));
      save (floor(request.input + request.output, chunk));
    }
    scheduler {
      // long_prefill_token_threshold, as in `multi-turn/vllm.sq`
      let threshold = running.count + waiting.count > 1 ? chunk_cap : inf;
      advance running each at most (threshold);
      // `multi-turn/vllm.sq`'s admission; a request that copies in takes
      // blocks for the copy and none for new work (scheduler.py:1069-1072)
      admit waiting while (running.preempted == 0) each at most (threshold)
        taking reqs (1),
          kv (min(request.known, request.hit + (request.loaded > 0 ? request.loaded : budget_left(vllm))))
          reserve (request.known)
        reuse (floor(request.known - 1, blocksize(kv)))
        cache (request.input + request.output);
    }
    worker {
      forward (c0 + max(hbm(batch.kv_decode + batch.kv_prefill), compute(batch.tokens)));
    }
  }
  pool reqs on vllm { queue fifo; }

  workload {
    arrive poisson(Lambda);
    hidden o;
    init { set K = 0; }
    turn {
      set n = ceil(K == 0 ? ~uniform(1000, 3000) : ~exp(500));
      set o = floor(~exp(200)) + 1;
      set more = ~bernoulli(p);
    }
    session {
      turn;
      while (more) {
        set K = K + n + o;
        tool (~exp(Z));
        turn;
      }
    }
  }

  server {
    vllm (K + n, o);
  }
}
