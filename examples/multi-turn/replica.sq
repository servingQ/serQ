// The paper's two-resource replica (§2.2, `prop:price`, `prop:decode`) on
// the open-session scenario of `libqueuingsim::validation::open_session_cfg`:
// one device runs iterations; every decoding turn advances one token per
// iteration (decode = processor sharing on memory bandwidth, iteration
// time omega + beta * K_B), and the compute the decode step leaves idle
// goes to the oldest prefill (prefill = FIFO in the leftover budget). The
// `tokens cap` fills each iteration exactly to its memory time, which is the
// fluid `TwoStage` server of `libqueuingsim::models::batch` at iteration
// granularity. Batch cap `B`, a KV pool of `C` tokens with shortest-first
// eviction (tool calls before waiting turns). The sessions, and their cap
// on live sessions: examples/workloads/replica.sq. One difference from
// `open_session_cfg`: a session's KV is dropped by the server after its last
// request, so before a last tool call, where libqueuingsim drops it after.
// An ended session's prefix then evicts no live one: fewer evictions and a
// higher hit rate, within the seeds' spread but always that way
// (docs/design/paired-workload.md, Validation).

let B = 8;           // batch cap (prefilling and decoding turns)
let C = 6e5;         // KV pool, tokens
let s0 = 0.005;      // per-turn overhead (s)
let a = 2e-5;        // prefill compute per token (s)
let b = 2e-9;        // prefill attention per token per context token (s)
let omega = 2e-4;    // weights read per iteration (s)
let beta = 2e-9;     // KV read per iteration per context token (s)

fn main() {
  pool reqs { cap B; }
  device gpu { compute (t) = t * a; hbm (k) = omega + beta * k; kv cap C; }
  engine llm on gpu {
    tokens cap max(running.decoding, (omega + beta * running.kv_decode) / a);    // fill the memory time
    scheduler {
      advance running decode first;                // prefill in what decode leaves
      admit waiting while (running.preempted == 0);
    }
    worker {
      forward (max(hbm(batch.kv_decode), compute(batch.tokens)));
    }
  }
  pool kv on gpu { evict by (waiting, size); }

  // the replica: one turn's prefill and decode
  server (K, n, o, cold, final) {
    hold reqs (cost(reqs, 1)), kv (cost(kv, K + n + o)) {
      set warm = !cold && cached >= K;
      // prefill work in tokens: the overhead and the attention term are
      // converted at the compute rate 1/a
      set P = s0 / a + (warm ? n + (b / a) * n * (K + n / 2)
                            : (K + n) + (b / a) * (K + n) * (K + n) / 2);
      llm (P, o + 1);   // the model's o decode steps after the prefill's sampled token
    } cache (cost(reqs, kv, K + n + o));
    if (!cold) { observe hit = warm; }
    // the session's last request: nothing of its prefix is read again
    if (final) { drop kv; }
  }
}
